+	Set result = ##class(%SQL.Statement).%ExecDirect(, "SELECT TOP 1 Slots FROM OcuTalon_Digest_Data.Sent WHERE SessionRef = ? ORDER BY ID DESC", session)
+	Quit $Select(result.%Next(): result.%Get("Slots"), 1: "")
