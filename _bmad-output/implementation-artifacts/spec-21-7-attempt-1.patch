+	Set result = ##class(%SQL.Statement).%ExecDirect(, "SELECT TOP 1 ChannelMessageId FROM OcuTalon_Data.Delivery WHERE OwnerRef = ? AND Channel = 'email' AND Kind = 'digest' ORDER BY ID DESC", session)
