+/// Matrix 8. A bad day count or a malformed now is an error that names the method, and nothing is deleted.
+Method TestBadArguments()
+{
+	Set old = ..Session(91)
+	Set oldTurn = ..Turn(old, ..Ago(91 * ..#DAY), .decisions)
