+	Do ..Check("pem " _ begin _ "\n" _ "ZmFrZQ==\ntail", "pem " _ mark, "also with escaped line breaks")
+	Set plain = "-----" _ "BEGIN PRIV" _ "ATE KEY-----" _ lf _ body _ lf _ "-----" _ "END PRIV" _ "ATE KEY-----"
