+/// Deletes the messages that a test stored in the trace by itself (Stored).
+Method DropStored() [ Private ]
+{
+	Set position = 0
+	While $ListNext(..Stored, position, entry) {
+		Do $ClassMethod($List(entry, 1), "%DeleteId", $List(entry, 2))
+	}
+	Set ..Stored = ""
+}
