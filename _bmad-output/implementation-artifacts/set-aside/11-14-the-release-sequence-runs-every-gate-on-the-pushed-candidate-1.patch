+# gh_repo <remote>: see the header.
+gh_repo() {
+  local url slug="" seam=${OCUTALON_RELEASE_GH_REPO:-}
+  url=$(git remote get-url "$1" < /dev/null 2> /dev/null) || url=""
+  url=${url%/}
+  url=${url%.git}
