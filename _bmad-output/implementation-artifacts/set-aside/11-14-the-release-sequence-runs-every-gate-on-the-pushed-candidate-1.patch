+step_ci() {
+  local cand repo json runs w red ok_list pending now pushed missing="" short
+  cand=$(sget cand_sha)
+  short=${cand%"${cand#???????}"}
+  if ! command -v gh > /dev/null 2>&1; then
+    step_fail ci "gh is not installed"
