+# upg_next <phase>: the harness phase after it.
+upg_next() {
+  local p want=""
+  for p in $UPG_PHASES; do
+    if [ "$want" = yes ]; then
+      echo "$p"
+      return 0
+    fi
+    [ "$p" != "$1" ] || want=yes
+  done
+  echo done
+}
