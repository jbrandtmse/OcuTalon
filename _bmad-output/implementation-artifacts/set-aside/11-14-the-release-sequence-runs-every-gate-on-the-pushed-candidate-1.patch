+      return 1
+    fi
+    head=$(git -C "$dir" rev-parse --verify --quiet HEAD < /dev/null 2> /dev/null)
+    if [ "$head" != "$sha" ]; then
+      rm -rf "$dir"
+      CLONE_WHY="the clone's HEAD is not the cut commit"
+      return 1
+    fi
+  fi
