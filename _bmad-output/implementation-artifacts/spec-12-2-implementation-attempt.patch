diff --git a/src/ocutalon/cls/OcuTalon/Test/Channel/LiveCase.cls b/src/ocutalon/cls/OcuTalon/Test/Channel/LiveCase.cls
new file mode 100644
index 00000000..0b86c48f
--- /dev/null
+++ b/src/ocutalon/cls/OcuTalon/Test/Channel/LiveCase.cls
@@ -0,0 +1,419 @@
+Include Ensemble
+
+/// The abstract base of the live Telegram tests (Story 12.2; AD-22, NFR-11). It has no Test methods, so it is no test class and joins no
+/// shard run. The classes that extend it run in throwaway stacks and in CI only (Rule 21), against the CI mock and its dummy token: the CI
+/// override points OCUTALON_TELEGRAM_API_BASE at the mock and sets TELEGRAM_BOT_TOKEN to a dummy.
+///   - Token, Ready, Finish and Safe: the guard that every live test starts with. Ready fails the test, with the reason, unless the stack
+///     is a throwaway with the mock and no TelegramIn job, and resets the mock's Bot API side; Finish resets it again. No text of a
+///     failure holds the token.
+///   - ReadyLive adds that the production runs, and saves the two Telegram marks. A test that enables an item calls it first.
+///   - StartItems and StopItems enable and disable items on the running production, with the System Default Setting row of each item's
+///     Enabled snapshotted before and put back after; the job of each item is waited for.
+///   - SaveMarks and RestoreMarks keep the marks telegramState and telegramPaused, DropChats deletes the Pairing rows of fixture chat ids,
+///     FixtureSession and DropSessions make and remove the zztg... sessions that StateBody needs, and Cleanup does all the endings, so
+///     that every test ends with the one call on every path.
+///   - The wait helpers poll for the offset, the Telegram state, a mark and the mock's calls.
+///   - WaitMonitor, InstanceSeq, Events, WaitEvent and WaitClear read the telegramPaused status events that the production's own
+///     StatusMonitor publishes on the instance stream (the pattern of OcuTalon.Test.Schedule.Stalled): the monitor's silent first run must be
+///     over, and a test that caused a pause waits for its clear, so that no event of it lands in a later test's window.
+Class OcuTalon.Test.Channel.LiveCase Extends %UnitTest.TestCase [ Abstract ]
+{
+
+Parameter MOCK = "OcuTalon.Test.Contract.Mock";
+
+Parameter BOTAPI = "OcuTalon.Test.Channel.BotApi";
+
+Parameter FIXTURE = "OcuTalon.Test.Agent.RunnerFixture";
+
+/// The longest, in seconds, that StartItems and StopItems wait for the jobs of an item.
+Parameter WAITJOB = 30;
+
+/// The two marks that the Telegram items write.
+Parameter MARKS = "telegramState,telegramPaused";
+
+/// The Bot API token of this stack (the CI dummy); never written anywhere.
+Property Token As %String [ Private ];
+
+/// The snapshots of the Enabled rows of the started items (RunnerFixture.RememberDefault).
+Property RowsFound As %String(MAXLEN = "") [ Private ];
+
+/// The started items, comma-separated.
+Property StartedItems As %String [ Private ];
+
+/// The marks as found, as a list of $ListBuild(mark, value).
+Property MarksFound As %String(MAXLEN = "") [ Private ];
+
+/// The fixture chat ids that Cleanup deletes, comma-separated.
+Property ChatIds As %String(MAXLEN = "") [ Private ];
+
+/// 1 when the test may send: the stack is a throwaway, no poller has a live job, and the reset worked.
+Method Ready() As %Boolean [ Private ]
+{
+	Set ..Token = $SYSTEM.Util.GetEnviron(##class(OcuTalon.Test.Contract.Mock).#TELEGRAMTOKENVAR)
+	Set reason = ##class(OcuTalon.Test.Contract.Mock).TelegramMissingReason($SYSTEM.Util.GetEnviron(##class(OcuTalon.Test.Contract.Mock).#TELEGRAMBASEVAR), ..Token)
+	If reason = "" Set reason = ##class(OcuTalon.Test.Channel.BotApi).PollerReason()
+	If reason '= "" {
+		Do $$$AssertTrue(0, reason)
+		Quit 0
+	}
+	Set status = ##class(OcuTalon.Test.Channel.BotApi).Reset()
+	Do $$$AssertStatusOK(status, "the mock's Bot API side is reset before the test")
+	Quit $$$ISOK(status)
+}
+
+/// Ends a test: the reset again, whatever happened.
+Method Finish() [ Private ]
+{
+	Do $$$AssertStatusOK(##class(OcuTalon.Test.Channel.BotApi).Reset(), "the mock's Bot API side is reset after the test")
+}
+
+/// The text of an exception with the token cut out.
+Method Safe(ex As %Exception.AbstractException) As %String [ Private ]
+{
+	Set text = $Translate(ex.DisplayString(), $Char(13, 10), "  ")
+	If ..Token '= "" Set text = $Replace(text, ..Token, "[token]")
+	Quit text
+}
+
+/// Ready, and the production must run (a test that enables an item needs it); the two Telegram marks are saved.
+Method ReadyLive() As %Boolean [ Private ]
+{
+	If '..Ready() Quit 0
+	Set reason = $ClassMethod(..#FIXTURE, "RunningReason")
+	If reason '= "" {
+		Do $$$AssertTrue(0, reason)
+		Quit 0
+	}
+	Do ..SaveMarks()
+	Quit 1
+}
+
+/// Enables each item (comma-separated) on the running production and waits for a job of it. The System Default Setting row of each
+/// item's Enabled is snapshotted first (a missing row is made with 0, so that the item's own flag is never saved), and StopItems puts it back.
+Method StartItems(items As %String) As %Status [ Private ]
+{
+	Set sc = $$$OK
+	For i = 1:1:$Length(items, ",") {
+		Set item = $Piece(items, ",", i)
+		Set rows = ..RowsFound
+		Do $ClassMethod(..#FIXTURE, "RememberDefault", .rows, item, "Enabled")
+		Set ..RowsFound = rows
+		If '$List($ClassMethod(..#FIXTURE, "SnapshotDefault", item, "Enabled"), 3) {
+			Set sc = $ClassMethod(..#FIXTURE, "PutDefault", item, "Enabled", 0)
+			If $$$ISERR(sc) Quit
+		}
+		Set ..StartedItems = ..StartedItems _ $Select(..StartedItems = "": "", 1: ",") _ item
+		Set sc = ##class(Ens.Director).EnableConfigItem(item, 1, 1)
+		If $$$ISERR(sc) Quit
+		If '..WaitJobs(item, 1) {
+			Set sc = $SYSTEM.Status.Error(5001, item_" has no job "_..#WAITJOB_" s after it was enabled")
+			Quit
+		}
+	}
+	Quit sc
+}
+
+/// Disables the started items, waits until each has no job, and puts the Enabled rows back. The status is the first failure; an
+/// item that is already disabled is not a failure. Safe to call when nothing was started.
+Method StopItems() As %Status [ Private ]
+{
+	Set first = $$$OK
+	For i = 1:1:$Length(..StartedItems, ",") {
+		Set item = $Piece(..StartedItems, ",", i)
+		If item = "" Continue
+		Set row = $ClassMethod(..#FIXTURE, "SnapshotDefault", item, "Enabled")
+		If $List(row, 3) && ($List(row, 4) '= 0) {
+			Set sc = ##class(Ens.Director).EnableConfigItem(item, 0, 1)
+			If $$$ISERR(sc) && $$$ISOK(first) Set first = sc
+		}
+		If '..WaitJobs(item, 0) && $$$ISOK(first) Set first = $SYSTEM.Status.Error(5001, item_" still has a job "_..#WAITJOB_" s after it was disabled")
+	}
+	Set sc = $ClassMethod(..#FIXTURE, "RestoreDefaults", ..RowsFound)
+	If $$$ISERR(sc) && $$$ISOK(first) Set first = sc
+	Set ..RowsFound = ""
+	Set ..StartedItems = ""
+	Quit first
+}
+
+/// 1 when the item has a job (running = 1) or has none (running = 0) within WAITJOB seconds.
+Method WaitJobs(item As %String, running As %Boolean) As %Boolean [ Private ]
+{
+	Set deadline = $ZHorolog + ..#WAITJOB
+	For {
+		Set has = ($ListLength($ClassMethod(..#FIXTURE, "Jobs", item)) > 0)
+		If (has = running) || ($ZHorolog >= deadline) Quit
+		Hang 0.5
+	}
+	Quit has = running
+}
+
+/// Saves the two Telegram marks as found.
+Method SaveMarks() [ Private ]
+{
+	Set ..MarksFound = ""
+	For i = 1:1:$Length(..#MARKS, ",") {
+		Set mark = $Piece(..#MARKS, ",", i)
+		Set ..MarksFound = ..MarksFound _ $ListBuild($ListBuild(mark, ##class(OcuTalon.Data.StatusMark).Get(mark)))
+	}
+}
+
+/// Puts the two Telegram marks back as SaveMarks found them (a mark that had no row is deleted).
+Method RestoreMarks() [ Private ]
+{
+	Set position = 0
+	While $ListNext(..MarksFound, position, one) {
+		Do ##class(OcuTalon.Data.StatusMark).Record($List(one, 1), $List(one, 2))
+	}
+}
+
+/// Adds fixture chat ids (comma-separated) to the ones that Cleanup deletes.
+Method Chat(ids As %String) [ Private ]
+{
+	Set ..ChatIds = ..ChatIds _ $Select(..ChatIds = "": "", 1: ",") _ ids
+}
+
+/// Deletes the Pairing rows of the chat ids (comma-separated).
+Method DropChats(ids As %String) [ Private ]
+{
+	For i = 1:1:$Length(ids, ",") {
+		Set id = $Piece(ids, ",", i)
+		If id '= "" Do ##class(%SQL.Statement).%ExecDirect(, "DELETE FROM OcuTalon_Data.Pairing WHERE ChatId = ?", id)
+	}
+}
+
+/// The number of Pairing rows of the chat id.
+Method ChatRows(chatId As %String) As %Integer [ Private ]
+{
+	Set result = ##class(%SQL.Statement).%ExecDirect(, "SELECT COUNT(*) FROM OcuTalon_Data.Pairing WHERE ChatId = ?", chatId)
+	Do result.%Next()
+	Quit +result.%GetData(1)
+}
+
+/// The highest id of the message headers: the mark that HeadersFrom reads from.
+ClassMethod HeaderMark() As %Integer [ Private ]
+{
+	Set result = ##class(%SQL.Statement).%ExecDirect(, "SELECT MAX(ID) FROM Ens.MessageHeader")
+	Do result.%Next()
+	Quit +result.%GetData(1)
+}
+
+/// The number of message headers after the mark whose source item is the item.
+ClassMethod HeadersFrom(mark As %Integer, item As %String) As %Integer [ Private ]
+{
+	Set result = ##class(%SQL.Statement).%ExecDirect(, "SELECT COUNT(*) FROM Ens.MessageHeader WHERE ID > ? AND SourceConfigName = ?", mark, item)
+	Do result.%Next()
+	Quit +result.%GetData(1)
+}
+
+/// A fixture session of the prefix (zztg...) for StateBody; its events and counters are removed by DropSessions.
+Method FixtureSession(prefix As %String) As OcuTalon.Data.Session [ Private ]
+{
+	Set session = ##class(OcuTalon.Data.Session).ForUser(prefix_$Increment(^OcuTalonTest("TelegramLive", "n")), .sc)
+	Do $$$AssertStatusOK(sc, "the fixture session is made")
+	Quit session
+}
+
+/// Deletes the fixture sessions (zztg...) with their events and counters.
+ClassMethod DropSessions() [ Private ]
+{
+	Set result = ##class(%SQL.Statement).%ExecDirect(, "SELECT Ref FROM OcuTalon_Data.Session WHERE IrisUser %STARTSWITH 'zztg'")
+	While result.%Next() {
+		Set stream = result.%Get("Ref")
+		Do ##class(%SQL.Statement).%ExecDirect(, "DELETE FROM OcuTalon_Live.Event WHERE Stream = ?", stream)
+		Kill ^OcuTalonP.LiveEventC(stream)
+	}
+	Do ##class(%SQL.Statement).%ExecDirect(, "DELETE FROM OcuTalon_Data.Session WHERE IrisUser %STARTSWITH 'zztg'")
+}
+
+/// The ending of every test, on every path: the items stopped and their rows put back, the marks put back, the fixture chats deleted
+/// and the mock reset.
+Method Cleanup() [ Private ]
+{
+	Do $$$AssertStatusOK(..StopItems(), "the started items are stopped and their rows put back")
+	Do ..RestoreMarks()
+	Do ..DropChats(..ChatIds)
+	Set ..ChatIds = ""
+	Do ..DropSessions()
+	Do ..Finish()
+}
+
+/// The calls of the mock with that method, in order, as a dynamic array.
+Method CallsOf(method As %String) As %DynamicArray [ Private ]
+{
+	Set found = []
+	Set iterator = ##class(OcuTalon.Test.Contract.Mock).Calls().%GetIterator()
+	While iterator.%GetNext(, .call) {
+		If call.method = method Do found.%Push(call)
+	}
+	Quit found
+}
+
+/// The calls with that method, once there are count of them or after seconds (whichever is first).
+Method WaitCalls(method As %String, count As %Integer, seconds As %Numeric = 20) As %DynamicArray [ Private ]
+{
+	Set deadline = $ZHorolog + seconds
+	For {
+		Set found = ..CallsOf(method)
+		If (found.%Size() >= count) || ($ZHorolog >= deadline) Quit
+		Hang 0.25
+	}
+	Quit found
+}
+
+/// 1 when the kept offset becomes want within the seconds.
+Method WaitOffset(want As %String, seconds As %Numeric = 20) As %Boolean [ Private ]
+{
+	Set deadline = $ZHorolog + seconds
+	For {
+		If ##class(OcuTalon.Test.Channel.BotApi).Offset() = want Quit
+		If $ZHorolog >= deadline Quit
+		Hang 0.25
+	}
+	Quit ##class(OcuTalon.Test.Channel.BotApi).Offset() = want
+}
+
+/// 1 when the Telegram state becomes want (off, on or rejected) within the seconds.
+Method WaitState(want As %String, seconds As %Numeric = 20) As %Boolean [ Private ]
+{
+	Set deadline = $ZHorolog + seconds
+	For {
+		If ##class(OcuTalon.Data.StatusMark).TelegramState() = want Quit
+		If $ZHorolog >= deadline Quit
+		Hang 0.25
+	}
+	Quit ##class(OcuTalon.Data.StatusMark).TelegramState() = want
+}
+
+/// 1 when the mark has a value (present = 1) or has none (present = 0) within the seconds.
+Method WaitMark(mark As %String, present As %Boolean, seconds As %Numeric = 20) As %Boolean [ Private ]
+{
+	Set deadline = $ZHorolog + seconds
+	For {
+		If (##class(OcuTalon.Data.StatusMark).Get(mark) '= "") = present Quit
+		If $ZHorolog >= deadline Quit
+		Hang 0.25
+	}
+	Quit (##class(OcuTalon.Data.StatusMark).Get(mark) '= "") = present
+}
+
+/// StatusMonitor's item, and its CallInterval in the production (seconds), plus a margin: its silent first run is over by then.
+Parameter MONITOR = "StatusMonitor";
+
+Parameter SETTLED = 17;
+
+/// The longest, in seconds, to wait for the monitor's job to be old enough.
+Parameter WAITMONITOR = 60;
+
+/// The longest, in seconds, to wait for a status event (one call interval of the monitor and a margin).
+Parameter WAITEVENT = 30;
+
+/// Waits until StatusMonitor's job has run past its silent first run; 1 when it has.
+Method WaitMonitor() As %Boolean [ Private ]
+{
+	Set deadline = $ZHorolog + ..#WAITMONITOR
+	While ('..MonitorSettled()) && ($ZHorolog < deadline) {
+		Hang 0.5
+	}
+	Quit ..MonitorSettled()
+}
+
+Method MonitorSettled() As %Boolean [ Private ]
+{
+	Set age = ..MonitorAge()
+	Quit (age '= "") && (age >= ..#SETTLED)
+}
+
+/// The whole seconds since the newest job of the StatusMonitor item was registered, or "" when there is none (see
+/// OcuTalon.Test.Schedule.StallFixture, whose private helper this follows).
+ClassMethod MonitorAge() As %Numeric [ Private ]
+{
+	Set newest = ""
+	Set job = ""
+	For {
+		Set job = $Order($$$EnsJobStatus($$$SystemName, job))
+		If job = "" Quit
+		If $Get($$$EnsJobStatus($$$SystemName, job, $$$eJobStartConfigName)) '= ..#MONITOR Continue
+		Set registered = ##class(OcuTalon.Data.Time).Seconds($Translate($Extract($Get($$$EnsJobStatus($$$SystemName, job, $$$eJobRegTime)), 1, 19), " ", "T")_"Z")
+		If registered = "" Continue
+		If (newest = "") || (registered > newest) Set newest = registered
+	}
+	If newest = "" Quit ""
+	Quit ##class(OcuTalon.Data.Time).Seconds(##class(OcuTalon.Data.Time).NowUtc()) - newest
+}
+
+/// The Seq of the last event on the instance stream.
+ClassMethod InstanceSeq() As %Integer [ Private ]
+{
+	Quit ##class(OcuTalon.Live.Publish).LastSeq(##class(OcuTalon.Live.Publish).#INSTANCE)
+}
+
+/// The telegramPaused status events of the instance stream after a Seq, in order.
+ClassMethod Events(after As %Integer) As %DynamicArray [ Private ]
+{
+	Set found = []
+	Set events = ##class(OcuTalon.Live.Event).Since(##class(OcuTalon.Live.Publish).#INSTANCE, after, 200, "instance")
+	Set iterator = events.%GetIterator()
+	While iterator.%GetNext(, .event) {
+		If (event.type = "status") && (event.payload.condition = "telegramPaused") Do found.%Push(event)
+	}
+	Quit found
+}
+
+/// The Seq of the first telegramPaused event after a Seq with that active, polled every 0.5 s for up to seconds; 0 when there is none.
+ClassMethod WaitEvent(after As %Integer, active As %Boolean, seconds As %Numeric = {..#WAITEVENT}) As %Integer [ Private ]
+{
+	Set deadline = $ZHorolog + seconds
+	For {
+		Set events = ..Events(after)
+		Set iterator = events.%GetIterator()
+		While iterator.%GetNext(, .event) {
+			If +event.payload.active = +active Return event.seq
+		}
+		If $ZHorolog >= deadline Quit
+		Hang 0.5
+	}
+	Quit 0
+}
+
+/// 1 when the last telegramPaused event after a Seq is a clear, or there is none; it waits for the clear up to WAITEVENT seconds more than
+/// a call interval of the monitor.
+ClassMethod WaitClear(after As %Integer) As %Boolean [ Private ]
+{
+	Set deadline = $ZHorolog + ..#WAITEVENT + 15
+	For {
+		Set events = ..Events(after)
+		If (events.%Size() = 0) || ('events.%Get(events.%Size() - 1).payload.active) Return 1
+		If $ZHorolog >= deadline Quit
+		Hang 0.5
+	}
+	Quit 0
+}
+
+/// The seconds since the start of Horolog day 0 of a UTC time stamp with milliseconds, such as the mock's ts (2026-10-31T10:00:00.123Z).
+ClassMethod Epoch(stamp As %String) As %Numeric [ Private ]
+{
+	Set day = $ZDateH($Piece(stamp, "T", 1), 3)
+	Set clock = $Piece($Piece(stamp, "T", 2), "Z", 1)
+	Quit (day * 86400) + ($Piece(clock, ":", 1) * 3600) + ($Piece(clock, ":", 2) * 60) + $Piece(clock, ":", 3)
+}
+
+/// The current time in the scale of Epoch, to the millisecond.
+ClassMethod EpochNow() As %Numeric [ Private ]
+{
+	Set now = $ZTimeStamp
+	Quit ($Piece(now, ",", 1) * 86400) + $Piece(now, ",", 2)
+}
+
+/// Queues updates through the mock's /updates (a list of update objects); 1 when it answered 200.
+Method QueueUpdates(updates As %DynamicArray) As %Boolean [ Private ]
+{
+	Quit ##class(OcuTalon.Test.Contract.Mock).Control("updates", updates)
+}
+
+/// A private-chat message update for the chat id.
+ClassMethod PrivateMessage(chatId As %Integer) As %DynamicObject [ Private ]
+{
+	Quit {"message": {"chat": {"id": (chatId), "type": "private"}, "text": "zz private"}}
+}
+
+}
diff --git a/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramApi.cls b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramApi.cls
new file mode 100644
index 00000000..4aab3491
--- /dev/null
+++ b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramApi.cls
@@ -0,0 +1,251 @@
+/// Tests of the Bot API client (Story 12.2; AD-14, AD-19, NFR-11). They run anywhere: nothing here needs the mock, except
+/// TestPlainHttpIgnoresSSLConfig, which also calls the mock when the stack is a throwaway with the CI dummy token.
+///   - TestSplitLineBreaks, TestSplitOneLongLine, TestSplitSurrogatePair, TestSplitLimits and TestSplitEmpty: Split cuts at the last line
+///     break inside the limit, else at the limit, never inside a surrogate pair, never makes an empty part, and the parts joined (with a
+///     line feed after a cut at a line break, with nothing after a cut at the limit) give the text back;
+///   - TestEndpoint: good bases give their parts, and a bad base gives an error that names the setting and not the value;
+///   - TestNoTokenInErrors: with a fake token set in the environment, a call to a closed port gives an error status that holds neither
+///     the token nor /bot, for an http and an https base, and Safe removes the token;
+///   - TestNoToken: with no token a call is not made, and the error says so;
+///   - TestPlainHttpIgnoresSSLConfig (U-164 condition 2): an http:// base makes a plain request, so a missing SSL configuration changes
+///     nothing, while an https:// base with a missing configuration is refused.
+/// The process environment is put back as found after each test.
+Class OcuTalon.Test.Channel.TelegramApi Extends %UnitTest.TestCase
+{
+
+Parameter API = "OcuTalon.Channel.Telegram.Api";
+
+Parameter ENV = "OcuTalon.Test.Agent.KeyScan";
+
+/// A token that no one uses: the exact-replacement test needs a value that the redactor does not know.
+Parameter FAKE = "zz-fake-bot-token-for-the-api-test";
+
+/// The environment variable as found: 1 when it was set, and its value.
+Property TokenSet As %Boolean [ Private ];
+
+Property TokenValue As %String(MAXLEN = "") [ Private ];
+
+Method OnBeforeAllTests() As %Status
+{
+	Set var = $Parameter(..#API, "TOKENVAR")
+	Set ..TokenSet = $ClassMethod(..#ENV, "HasEnv", var)
+	Set ..TokenValue = $SYSTEM.Util.GetEnviron(var)
+	Quit $$$OK
+}
+
+Method OnAfterOneTest(testname As %String) As %Status
+{
+	Do ..PutBack()
+	Quit $$$OK
+}
+
+Method OnAfterAllTests() As %Status
+{
+	Do ..PutBack()
+	Quit $$$OK
+}
+
+/// Puts the token variable back as OnBeforeAllTests found it.
+Method PutBack() [ Private ]
+{
+	Set var = $Parameter(..#API, "TOKENVAR")
+	If ..TokenSet {
+		Do $ClassMethod(..#ENV, "SetEnv", var, ..TokenValue)
+	} Else {
+		Do $ClassMethod(..#ENV, "UnsetEnv", var)
+	}
+}
+
+/// The text of n lines of 89 characters, joined with line feeds.
+ClassMethod Lines(n As %Integer) As %String [ Private ]
+{
+	Set text = ""
+	For i = 1:1:n {
+		Set line = "L"_i_" "
+		Set line = line_$Extract($TRanslate($J("", 89), " ", "x"), 1, 89 - $Length(line))
+		Set text = text _ $Select(i = 1: "", 1: $Char(10)) _ line
+	}
+	Quit text
+}
+
+/// The parts as a $ListBuild list joined with the separator.
+ClassMethod Joined(parts As %List, separator As %String) As %String [ Private ]
+{
+	Quit $ListToString(parts, separator)
+}
+
+/// The longest part of a list of parts.
+ClassMethod Longest(parts As %List) As %Integer [ Private ]
+{
+	Set longest = 0
+	Set position = 0
+	While $ListNext(parts, position, part) {
+		If $Length(part) > longest Set longest = $Length(part)
+	}
+	Quit longest
+}
+
+/// 9,000 characters of 90-character lines: each part is at most 4,096, each is cut at a line break, they come in order, and the parts
+/// joined with a line feed are the text.
+Method TestSplitLineBreaks()
+{
+	Set text = ..Lines(101)
+	Do $$$AssertTrue($Length(text) > 9000, "the text is over 9,000 characters")
+	Set parts = $ClassMethod(..#API, "Split", text, 4096)
+	Do $$$AssertEquals($ListLength(parts), 3, "three parts")
+	Do $$$AssertTrue(..Longest(parts) <= 4096, "each part is 4,096 characters or fewer")
+	Do $$$AssertEquals(..Joined(parts, $Char(10)), text, "the parts joined with a line feed are the text")
+	Set whole = 1
+	Set position = 0
+	While $ListNext(parts, position, part) {
+		For i = 1:1:$Length(part, $Char(10)) {
+			If $Length($Piece(part, $Char(10), i)) '= 89 Set whole = 0
+		}
+	}
+	Do $$$AssertEquals(whole, 1, "every part is cut at a line break: it holds whole lines only")
+	Do $$$AssertEquals($Length($List(parts, 1)), 45 * 89 + 44, "the first part is cut at the last line break inside the limit")
+}
+
+/// A line of 9,000 characters with no break: 4,096, 4,096 and the rest; the parts joined with nothing are the text.
+Method TestSplitOneLongLine()
+{
+	Set text = $TRanslate($J("", 9000), " ", "a")
+	Set parts = $ClassMethod(..#API, "Split", text, 4096)
+	Do $$$AssertEquals($ListLength(parts), 3, "three parts")
+	Do $$$AssertEquals($Length($List(parts, 1))_"|"_$Length($List(parts, 2))_"|"_$Length($List(parts, 3)), "4096|4096|808", "cut at the limit")
+	Do $$$AssertEquals(..Joined(parts, ""), text, "the parts joined with nothing are the text")
+}
+
+/// A surrogate pair that straddles the limit is never split.
+Method TestSplitSurrogatePair()
+{
+	Set pair = $Char(55357, 56832)
+	Set text = $TRanslate($J("", 4095), " ", "a")_pair_$TRanslate($J("", 5000), " ", "b")
+	Set parts = $ClassMethod(..#API, "Split", text, 4096)
+	Do $$$AssertTrue(..Longest(parts) <= 4096, "each part is 4,096 units or fewer")
+	Do $$$AssertEquals(..Joined(parts, ""), text, "the parts joined with nothing are the text")
+	Set clean = 1
+	Set position = 0
+	While $ListNext(parts, position, part) {
+		If ($Ascii(part, $Length(part)) >= 55296) && ($Ascii(part, $Length(part)) <= 56319) Set clean = 0
+		If ($Ascii(part, 1) >= 56320) && ($Ascii(part, 1) <= 57343) Set clean = 0
+	}
+	Do $$$AssertEquals(clean, 1, "no part ends with half a pair or starts with the other half")
+	Do $$$AssertEquals($Length($List(parts, 1)), 4095, "the first part is one unit short of the limit, so that the pair stays whole")
+}
+
+/// A text of exactly the limit is one part, one unit more is two, and a text of line feeds only makes no empty part.
+Method TestSplitLimits()
+{
+	Set exact = $TRanslate($J("", 4096), " ", "a")
+	Do $$$AssertEquals($ListLength($ClassMethod(..#API, "Split", exact, 4096)), 1, "a text of exactly 4,096 is one part")
+	Do $$$AssertEquals($List($ClassMethod(..#API, "Split", exact, 4096), 1), exact, "unchanged")
+	Set over = exact_"b"
+	Set parts = $ClassMethod(..#API, "Split", over, 4096)
+	Do $$$AssertEquals($ListLength(parts)_"|"_$Length($List(parts, 2)), "2|1", "4,097 is two parts, the second one unit")
+	Set breaks = $TRanslate($J("", 9000), " ", $Char(10))
+	Set parts = $ClassMethod(..#API, "Split", breaks, 4096)
+	Set empty = 0
+	Set position = 0
+	While $ListNext(parts, position, part) {
+		If part = "" Set empty = empty + 1
+	}
+	Do $$$AssertEquals(empty, 0, "a text of line feeds makes no empty part")
+	Do $$$AssertTrue(..Longest(parts) <= 4096, "and each part is within the limit")
+	Set short = "a*b_c [x](y) `z` <b>&amp; 1.5! #t"
+	Do $$$AssertEquals($List($ClassMethod(..#API, "Split", short), 1), short, "a short text is one part, byte for byte, with the default limit")
+}
+
+/// An empty text has no part.
+Method TestSplitEmpty()
+{
+	Do $$$AssertEquals($ListLength($ClassMethod(..#API, "Split", "", 4096)), 0, "an empty text has no part")
+}
+
+/// Good and bad bases.
+Method TestEndpoint()
+{
+	Set sc = $ClassMethod(..#API, "Endpoint", "http://mock:8080", .server, .port, .https, .prefix)
+	Do $$$AssertStatusOK(sc, "an http base with a port")
+	Do $$$AssertEquals(server_"|"_port_"|"_https_"|"_prefix, "mock|8080|0|", "its parts")
+	Set sc = $ClassMethod(..#API, "Endpoint", "https://api.telegram.org", .server, .port, .https, .prefix)
+	Do $$$AssertEquals(server_"|"_port_"|"_https_"|"_prefix, "api.telegram.org|443|1|", "the public API: https, port 443")
+	Set sc = $ClassMethod(..#API, "Endpoint", "http://host", .server, .port, .https, .prefix)
+	Do $$$AssertEquals(server_"|"_port_"|"_https_"|"_prefix, "host|80|0|", "an http base with no port: 80")
+	Set sc = $ClassMethod(..#API, "Endpoint", "https://gateway.example:8443/relay/tg/", .server, .port, .https, .prefix)
+	Do $$$AssertStatusOK(sc, "a base with a path")
+	Do $$$AssertEquals(server_"|"_port_"|"_https_"|"_prefix, "gateway.example|8443|1|/relay/tg", "its path, without the trailing slash")
+	Set sc = $ClassMethod(..#API, "Endpoint", "http://mock:8080/", .server, .port, .https, .prefix)
+	Do $$$AssertEquals(prefix, "", "a lone slash is no path")
+	For bad = "", "mock:8080", "ftp://mock", "http://", "https://:80", "http://a b", "http://h:99999", "http://h:0", "http://h:x", "http://h?q=1", "http://h/p#f", "//h" {
+		Set sc = $ClassMethod(..#API, "Endpoint", bad, .server, .port, .https, .prefix)
+		Do $$$AssertStatusNotOK(sc, "'"_bad_"' is refused")
+		Do $$$AssertTrue($Find($SYSTEM.Status.GetErrorText(sc), "ApiBase") > 0, "'"_bad_"': the error names the setting")
+	}
+	Set sc = $ClassMethod(..#API, "Endpoint", "http://zz-secret-host:99999/zz-secret-path", .server, .port, .https, .prefix)
+	Do $$$AssertEquals($Find($SYSTEM.Status.GetErrorText(sc), "zz-secret"), 0, "the error holds neither the host nor the path of the base")
+}
+
+/// A call to a closed port, with a fake token in the environment: the error holds neither the token nor /bot, and Safe cuts the token.
+Method TestNoTokenInErrors()
+{
+	Set var = $Parameter(..#API, "TOKENVAR")
+	Do $ClassMethod(..#ENV, "SetEnv", var, ..#FAKE)
+	For base = "http://127.0.0.1:1", "https://127.0.0.1:1" {
+		Set answer = $ClassMethod(..#API, "Call", base, "NoSuchConfig", "getMe", {}, 2, .code, .sc)
+		Do $$$AssertEquals(answer, "", base_": no answer")
+		Do $$$AssertStatusNotOK(sc, base_": an error status")
+		Set text = $SYSTEM.Status.GetErrorText(sc)
+		Do $$$AssertEquals($Find(text, ..#FAKE), 0, base_": the error text holds no token")
+		Do $$$AssertEquals($Find(text, "/bot"), 0, base_": and no path")
+		Do $$$AssertEquals($Find(text, "127.0.0.1"), 0, base_": and no host")
+		Do $$$AssertTrue($Find(text, "getMe") > 0, base_": it names the method")
+	}
+	Set safe = $ClassMethod(..#API, "Safe", "before "_..#FAKE_" after")
+	Do $$$AssertEquals($Find(safe, ..#FAKE), 0, "Safe removes the exact token")
+	Do $$$AssertEquals(safe, "before [redacted] after", "and leaves the rest")
+	Set bad = $ClassMethod(..#API, "Failure", "getMe", 401, {"ok": false, "description": ("Unauthorized "_..#FAKE)})
+	Do $$$AssertEquals($Find(bad, ..#FAKE), 0, "Failure removes the token from Telegram's description")
+	Do $$$AssertEquals(bad, "Telegram answered getMe with HTTP 401: Unauthorized [redacted]", "and is a fixed phrase with the method, the status and the description")
+}
+
+/// With no token the call is not made.
+Method TestNoToken()
+{
+	Do $ClassMethod(..#ENV, "UnsetEnv", $Parameter(..#API, "TOKENVAR"))
+	Set answer = $ClassMethod(..#API, "Call", "http://127.0.0.1:1", "", "getMe", {}, 2, .code, .sc)
+	Do $$$AssertEquals(answer_"|"_code, "|", "no answer and no HTTP status")
+	Do $$$AssertStatusNotOK(sc, "an error status")
+	Do $$$AssertTrue($Find($SYSTEM.Status.GetErrorText(sc), "no bot token") > 0, "which says that no token is set")
+	Set answer = $ClassMethod(..#API, "Call", "ftp://x", "", "getMe", {}, 2, .code, .sc)
+	Do $$$AssertStatusNotOK(sc, "a bad base is an error even with no token")
+}
+
+/// U-164 condition 2: an http:// base is a plain request. The SSL configuration named does not exist, and the call works against the mock
+/// (when this stack is a throwaway with the mock and the CI dummy token); the same missing configuration on an https:// base is refused.
+Method TestPlainHttpIgnoresSSLConfig()
+{
+	Set mock = "OcuTalon.Test.Contract.Mock"
+	Set base = $SYSTEM.Util.GetEnviron($Parameter(mock, "TELEGRAMBASEVAR"))
+	Set reason = $ClassMethod(mock, "TelegramMissingReason", base, $SYSTEM.Util.GetEnviron($Parameter(mock, "TELEGRAMTOKENVAR")))
+	If reason = "" Set reason = $ClassMethod("OcuTalon.Test.Channel.BotApi", "PollerReason")
+	If reason '= "" Quit
+	Set answer = $ClassMethod(..#API, "Call", base, "ZzNoSuchSSLConfig", "getMe", {}, 5, .code, .sc)
+	Do $$$AssertStatusOK(sc, "a call to the mock's http base works with a configuration that does not exist")
+	Do $$$AssertEquals(code, 200, "answered 200")
+	Set name = ""
+	Set ok = 0
+	If $IsObject(answer) {
+		Set ok = +answer.ok
+		If $IsObject(answer.result) Set name = answer.result.username
+	}
+	Do $$$AssertEquals(ok, 1, "with an ok answer")
+	Do $$$AssertEquals(name, "ocutalon_ci_bot", "that is the mock's getMe")
+	Set secure = $Replace(base, "http://", "https://")
+	Set answer = $ClassMethod(..#API, "Call", secure, "ZzNoSuchSSLConfig", "getMe", {}, 5, .code, .sc)
+	Do $$$AssertEquals(answer, "", "the same host over https with that configuration gets no answer")
+	Do $$$AssertStatusNotOK(sc, "it is an error status")
+	Do $$$AssertStatusOK($ClassMethod("OcuTalon.Test.Channel.BotApi", "Reset"), "the mock's Bot API side is reset after the test")
+}
+
+}
diff --git a/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramIn.cls b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramIn.cls
new file mode 100644
index 00000000..bcbef901
--- /dev/null
+++ b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramIn.cls
@@ -0,0 +1,260 @@
+Include Ensemble
+
+/// Live tests of TelegramIn against the CI mock (Story 12.2; FR-19, FR-21, AD-14, AD-19, AD-5, DW-422). THESE TESTS RUN IN THROWAWAY
+/// STACKS AND IN CI ONLY (Rule 21), like OcuTalon.Test.Channel.LiveCase, which they extend: each test enables TelegramIn on the running
+/// production, against the mock and its dummy token, and ends with Cleanup (the item stopped and its Enabled row put back, both Telegram
+/// marks put back, the fixture chats deleted, the mock reset). Fixture chat ids are 7001 and 83xx only.
+///   - TestStart: the state becomes on with the bot's name, the calls are getMe and then getUpdates with timeout 5, the two allowed update
+///     kinds and no offset, and StateBody says on and the name;
+///   - TestStop: a stop during an open long poll returns OK within 10 s, leaves no job and records off;
+///   - TestOffsetNode (DW-422): the offset that BotApi.SetOffset sets is carried by the first poll, only the update at it is handled, and
+///     the node moves to the next id, which the next poll carries;
+///   - TestRestartLosesNothing: an update handled before a stop is not handled again, one queued while stopped is handled once;
+///   - TestAlreadyHandled: an update below the kept offset is skipped and the offset stays;
+///   - TestPrivateOnly (FR-19): only the private message and the private press make a chat row, with no session and no name, with no
+///     reply, no message header and no audit entry;
+///   - TestRejected (FR-21): a 401 for getMe records rejected with no name, makes no other call, logs it without the token, and the
+///     state stays rejected after a stop;
+///   - TestUpdatesBusy: a 429 for getUpdates delays the next poll by its retry_after and logs one warning.
+Class OcuTalon.Test.Channel.TelegramIn Extends OcuTalon.Test.Channel.LiveCase
+{
+
+/// The bot name of the mock's getMe default.
+Parameter BOT = "ocutalon_ci_bot";
+
+/// A scripted update's chat (telegram-private-update).
+Parameter SCRIPTED = 7001;
+
+/// The state, the name and the pause of StateBody's telegram block, as text.
+Method TelegramBlock(session As OcuTalon.Data.Session) As %String [ Private ]
+{
+	Set telegram = ##class(OcuTalon.Web.Api).StateBody(session).telegram
+	Quit telegram.state_"|"_telegram.botUserName
+}
+
+/// The state becomes on with the bot's name before the first poll; the first calls are getMe and getUpdates.
+Method TestStart()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set session = ..FixtureSession("zztgin")
+		Do ##class(OcuTalon.Data.StatusMark).RecordTelegram("rejected", "")
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled")
+		Do $$$AssertTrue(..WaitState("on", 20), "the state becomes on")
+		Set state = ##class(OcuTalon.Data.StatusMark).TelegramState(.bot)
+		Do $$$AssertEquals(state_"|"_bot, "on|"_..#BOT, "with the bot's user name from getMe")
+		Set polls = ..WaitCalls("getUpdates", 1, 20)
+		Do $$$AssertTrue(polls.%Size() >= 1, "TelegramIn polls")
+		Set calls = ##class(OcuTalon.Test.Contract.Mock).Calls()
+		Do $$$AssertTrue(calls.%Size() >= 2, "the mock lists the calls")
+		If calls.%Size() >= 2 {
+			Do $$$AssertEquals(calls.%Get(0).method_"|"_calls.%Get(1).method, "getMe|getUpdates", "the first calls are getMe, then getUpdates")
+			Set params = calls.%Get(1).params
+			Do $$$AssertEquals(params.timeout, 5, "getUpdates waits 5 seconds")
+			Do $$$AssertEquals(params."allowed_updates".%ToJSON(), "[""message"",""callback_query""]", "and asks for messages and button presses only")
+			Do $$$AssertEquals(params.%IsDefined("offset"), 0, "with no offset when none is kept")
+		}
+		Do $$$AssertEquals(..TelegramBlock(session), "on|"_..#BOT, "StateBody says on and the bot's name")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the start test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// A stop during an open long poll is done within 10 s, leaves no job, and records off.
+Method TestStop()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled")
+		Do $$$AssertTrue(..WaitState("on", 20), "the state becomes on")
+		Do $$$AssertTrue(..WaitCalls("getUpdates", 1, 20).%Size() >= 1, "a long poll is open")
+		Hang 1
+		Set start = $ZHorolog
+		Set sc = ##class(Ens.Director).EnableConfigItem("TelegramIn", 0, 1)
+		Set seconds = $ZHorolog - start
+		Do $$$AssertStatusOK(sc, "the stop returns OK")
+		Do $$$AssertTrue(seconds < 10, "within 10 seconds: "_$Justify(seconds, 0, 1))
+		Do $$$AssertEquals($ListLength(##class(OcuTalon.Test.Agent.RunnerFixture).Jobs("TelegramIn")), 0, "no TelegramIn job remains")
+		Do $$$AssertEquals(##class(OcuTalon.Data.StatusMark).TelegramState(.bot)_"|"_bot, "off|", "the state is off, with no name")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the stop test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// DW-422: the kept offset is the node BotApi reads.
+Method TestOffsetNode()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Do ..Chat("7001,8301,8302")
+		Do ..DropChats("7001,8301,8302")
+		Do ##class(OcuTalon.Test.Channel.BotApi).SetOffset(3)
+		Do $$$AssertTrue(..QueueUpdates([(..PrivateMessage(7001)), (..PrivateMessage(8301)), (..PrivateMessage(8302))]), "three updates, ids 1 to 3, are queued")
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled")
+		Do $$$AssertTrue(..WaitOffset(4), "the kept offset becomes 4")
+		Set polls = ..WaitCalls("getUpdates", 2, 20)
+		Do $$$AssertTrue(polls.%Size() >= 2, "TelegramIn polls again")
+		If polls.%Size() >= 2 {
+			Do $$$AssertEquals(polls.%Get(0).params.offset, 3, "the first poll carries the offset that was set")
+			Do $$$AssertEquals(polls.%Get(1).params.offset, 4, "the next poll carries the node's new value")
+		}
+		Do $$$AssertEquals(..ChatRows(7001)_"|"_..ChatRows(8301)_"|"_..ChatRows(8302), "0|0|1", "only update 3 is handled")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the offset test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// A handled update is not handled again after a restart, and one queued while the item was stopped is handled once.
+Method TestRestartLosesNothing()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Do ..Chat("8311,8312")
+		Do ..DropChats("8311,8312")
+		Do $$$AssertTrue(..QueueUpdates([(..PrivateMessage(8311))]), "update A is queued")
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled")
+		Do $$$AssertTrue(..WaitOffset(2), "update A is handled and the offset is 2")
+		Do $$$AssertEquals(..ChatRows(8311), 1, "A made its chat row")
+		Do $$$AssertStatusOK(..StopItems(), "TelegramIn is stopped")
+		Do ..DropChats("8311")
+		Do $$$AssertTrue(..QueueUpdates([(..PrivateMessage(8312))]), "update B is queued while the item is stopped")
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled again")
+		Do $$$AssertTrue(..WaitOffset(3), "B is handled and the offset moves past it")
+		Do $$$AssertEquals(..ChatRows(8312), 1, "B made its chat row, once")
+		Hang 2
+		Do $$$AssertEquals(..ChatRows(8311), 0, "A is not handled again")
+		Do $$$AssertEquals(##class(OcuTalon.Test.Channel.BotApi).Offset(), 3, "the offset stays past B")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the restart test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// An update below the kept offset is skipped.
+Method TestAlreadyHandled()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Do ..Chat(..#SCRIPTED)
+		Do ..DropChats(..#SCRIPTED)
+		Do ##class(OcuTalon.Test.Channel.BotApi).SetOffset(2)
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-private-update"}), "the scripted private update (id 1) is queued")
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled")
+		Do $$$AssertTrue(..WaitCalls("getUpdates", 2, 20).%Size() >= 2, "the scripted update was answered and TelegramIn polled again")
+		Do $$$AssertEquals(..ChatRows(..#SCRIPTED), 0, "no chat row appears for the skipped update")
+		Do $$$AssertEquals(##class(OcuTalon.Test.Channel.BotApi).Offset(), 2, "and the offset stays 2")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the already-handled test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// FR-19: only private messages and private presses are handled, and handling them records the chat, with nothing else.
+Method TestPrivateOnly()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set ids = "8321,8322,8323,8324,8325"
+		Do ..Chat(ids)
+		Do ..DropChats(ids)
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled")
+		Do $$$AssertTrue(..WaitState("on", 20), "the state becomes on")
+		Do $$$AssertTrue(..WaitCalls("getUpdates", 1, 20).%Size() >= 1, "a poll is open")
+		Set headers = ..HeaderMark()
+		Set audit = ##class(OcuTalon.Test.Bridge.AuditLog).Now()
+		Set batch = []
+		Do batch.%Push({"message": {"chat": {"id": 8321, "type": "group"}, "text": "zz group"}})
+		Do batch.%Push({"channel_post": {"chat": {"id": 8322, "type": "channel"}, "text": "zz channel"}})
+		Do batch.%Push({"callback_query": {"id": "zz1", "data": "zz", "message": {"message_id": 1, "chat": {"id": 8323, "type": "group"}}}})
+		Do batch.%Push(..PrivateMessage(8324))
+		Do batch.%Push({"callback_query": {"id": "zz2", "data": "zz", "message": {"message_id": 2, "chat": {"id": 8325, "type": "private"}}}})
+		Do $$$AssertTrue(..QueueUpdates(batch), "five updates are queued in one batch")
+		Do $$$AssertTrue(..WaitOffset(6), "the offset is past all five")
+		Do $$$AssertEquals(..ChatRows(8321)_"|"_..ChatRows(8322)_"|"_..ChatRows(8323), "0|0|0", "the group, channel and group-press updates make no chat row")
+		Do $$$AssertEquals(..ChatRows(8324)_"|"_..ChatRows(8325), "1|1", "the private message and the private press make one each")
+		For id = 8324, 8325 {
+			Set result = ##class(%SQL.Statement).%ExecDirect(, "SELECT SessionRef, DisplayName FROM OcuTalon_Data.Pairing WHERE ChatId = ?", id)
+			Do result.%Next()
+			Do $$$AssertEquals(result.%GetData(1)_"|"_result.%GetData(2), "|", "the row of "_id_" holds no session and no name")
+		}
+		Do $$$AssertEquals(..CallsOf("sendMessage").%Size(), 0, "no reply is sent")
+		Do $$$AssertEquals(..HeadersFrom(headers, "TelegramIn"), 0, "TelegramIn sends no message")
+		Do $$$AssertEquals(##class(OcuTalon.Test.Bridge.AuditLog).Entries(audit, "OcuTalon").%Size(), 0, "and no audit entry is written")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the private-only test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// FR-21: getMe answers 401, so Telegram stays off for that start and the state is rejected.
+Method TestRejected()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set session = ..FixtureSession("zztgin")
+		Set log = ##class(OcuTalon.Test.Agent.RunnerFixture).EventMark()
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-getme-rejected"}), "a rejected getMe is queued")
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled")
+		Do $$$AssertTrue(..WaitState("rejected", 20), "the state becomes rejected")
+		Set state = ##class(OcuTalon.Data.StatusMark).TelegramState(.bot)
+		Do $$$AssertEquals(state_"|"_bot, "rejected|", "with an empty name")
+		Hang 4
+		Set calls = ##class(OcuTalon.Test.Contract.Mock).Calls()
+		Do $$$AssertEquals(calls.%Size(), 1, "within 4 seconds the only call is one call")
+		Do $$$AssertEquals(calls.%Get(0).method, "getMe", "and it is getMe")
+		Do $$$AssertEquals(..TelegramBlock(session), "rejected|", "StateBody says rejected")
+		Set rows = ##class(OcuTalon.Test.Agent.RunnerFixture).EventRows(log, "TelegramIn")
+		Set told = 0, position = 0
+		While $ListNext(rows, position, row) {
+			If ($Extract(row, 1, 2) = "3:") && ($Find(row, "rejected the bot token") > 0) && ($Find(row, "until the next start") > 0) Set told = told + 1
+		}
+		Do $$$AssertEquals(told, 1, "one warning says that Telegram rejected the token and stays off until the next start")
+		Do $$$AssertEquals(##class(OcuTalon.Test.Agent.RunnerFixture).LogRowsHolding(log, ..Token), 0, "no log row holds the token")
+		Do $$$AssertStatusOK(..StopItems(), "TelegramIn is stopped")
+		Do $$$AssertEquals(##class(OcuTalon.Data.StatusMark).TelegramState(.bot)_"|"_bot, "rejected|", "after the stop the state is still rejected")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the rejected test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// A 429 for getUpdates delays the next poll by its retry_after.
+Method TestUpdatesBusy()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set log = ##class(OcuTalon.Test.Agent.RunnerFixture).EventMark()
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled")
+		Do $$$AssertTrue(..WaitState("on", 20), "the state becomes on")
+		Do $$$AssertTrue(..WaitCalls("getUpdates", 1, 20).%Size() >= 1, "a poll is open")
+		Set queuedAt = ..EpochNow()
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-updates-busy"}), "a 429 with retry_after 3 is queued while the poll is open")
+		Set next = ""
+		Set deadline = $ZHorolog + 20
+		For {
+			Set polls = ..CallsOf("getUpdates")
+			For i = 0:1:polls.%Size() - 1 {
+				If ..Epoch(polls.%Get(i).ts) > queuedAt Set next = polls.%Get(i).ts  Quit
+			}
+			If (next '= "") || ($ZHorolog >= deadline) Quit
+			Hang 0.25
+		}
+		Do $$$AssertTrue(next '= "", "TelegramIn polls again")
+		If next '= "" Do $$$AssertTrue((..Epoch(next) - queuedAt) >= 3, "at least 3 seconds after the 429: "_$Justify(..Epoch(next) - queuedAt, 0, 2))
+		Set rows = ##class(OcuTalon.Test.Agent.RunnerFixture).EventRows(log, "TelegramIn")
+		Set told = 0, position = 0
+		While $ListNext(rows, position, row) {
+			If ($Extract(row, 1, 2) = "3:") && ($Find(row, "asked TelegramIn to wait") > 0) Set told = told + 1
+		}
+		Do $$$AssertEquals(told, 1, "one warning says that Telegram asked it to wait")
+		Do $$$AssertEquals(##class(OcuTalon.Test.Agent.RunnerFixture).LogRowsHolding(log, ..Token), 0, "no log row holds the token")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the busy test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+}
