diff --git a/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramNoToken.cls b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramNoToken.cls
new file mode 100644
index 00000000..0b5d7c4c
--- /dev/null
+++ b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramNoToken.cls
@@ -0,0 +1,200 @@
+/// The token search of the Telegram items (Story 12.2; NFR-11, AD-14, AD-19). THIS TEST RUNS IN THROWAWAY STACKS AND IN CI ONLY (Rule 21),
+/// like OcuTalon.Test.Channel.LiveCase, which it extends: it runs every failure path of the items against the CI mock and its dummy token,
+/// and then looks for the token in every place that could hold it. The paths are a rejected start, a 409 (with its pause onset on the
+/// instance stream), a 429 for getUpdates, a 429 for sendMessage that ends in an error status, a client call to a closed port, and a client
+/// call to the mock with no token. The places are the production's settings and item settings, the event log and the saved sessions
+/// (KeyScan.Find), the %Status texts that the paths returned, the message headers and the exported bodies since the mark, the audit entries
+/// since the mark, the live events since the mark, and the body of /state. Every scan has a positive control, a value that its store does
+/// hold, so that a scan that cannot read its store is not read as clean:
+///   - KeyScan.Find: the base of the mock, which the ApiBase rows hold;
+///   - the %Status texts: the method name that the closed-port error carries;
+///   - the message bodies: the test's unique text in the Outbound body;
+///   - the audit entries: a Pairing entry that the test writes through the product's audit writer with a unique reason;
+///   - the live events: the pause time in StatusMonitor's onset;
+///   - /state: ocutalon_ci_bot.
+Class OcuTalon.Test.Channel.TelegramNoToken Extends OcuTalon.Test.Channel.LiveCase
+{
+
+Parameter API = "OcuTalon.Channel.Telegram.Api";
+
+/// The statuses' texts that the paths returned, as a list.
+Property Texts As %String(MAXLEN = "") [ Private ];
+
+/// Every text of every row of a SELECT that names its columns, as one text.
+ClassMethod RowsText(sql As %String, mark As %Integer) As %String [ Private ]
+{
+	Set text = ""
+	Set result = ##class(%SQL.Statement).%ExecDirect(, sql, mark)
+	While result.%Next() {
+		For column = 1:1:result.%ResultColumnCount {
+			Set text = text _ result.%GetData(column) _ $Char(10)
+		}
+	}
+	Quit text
+}
+
+/// The exported body of every message header after the mark, as one text.
+ClassMethod Bodies(mark As %Integer) As %String [ Private ]
+{
+	Set text = ""
+	Set result = ##class(%SQL.Statement).%ExecDirect(, "SELECT MessageBodyClassName, MessageBodyId FROM Ens.MessageHeader WHERE ID > ?", mark)
+	While result.%Next() {
+		Set class = result.%GetData(1)
+		Set id = result.%GetData(2)
+		If (class = "") || (id = "") Continue
+		Try {
+			Set body = $ClassMethod(class, "%OpenId", id)
+			If $IsObject(body) {
+				Set xml = ""
+				If body.%Extends("%XML.Adaptor") && $$$ISOK(body.XMLExportToString(.xml)) Set text = text _ xml _ $Char(10)
+			}
+		} Catch {
+			Set text = text _ "body not readable: " _ class _ $Char(10)
+		}
+	}
+	Quit text
+}
+
+/// Keeps the text of a status for the scan.
+Method Keep(sc As %Status) [ Private ]
+{
+	Set ..Texts = ..Texts _ $ListBuild($SYSTEM.Status.GetErrorText(sc))
+}
+
+/// The token is in none of the places, and every scan finds what its store holds.
+Method TestNoTokenAnywhere()
+{
+	If '..ReadyLive() Quit
+	Set var = $Parameter(..#API, "TOKENVAR")
+	Set since = ..InstanceSeq()
+	Try {
+		Set session = ..FixtureSession("zztgtok")
+		Set token = ..Token
+		Do $$$AssertTrue(token '= "", "this stack has the dummy token")
+		Do $$$AssertTrue(..WaitMonitor(), "StatusMonitor's job is past its silent first run")
+		Set since = ..InstanceSeq()
+		Set log = ##class(OcuTalon.Test.Agent.RunnerFixture).EventMark()
+		Set headers = ..HeaderMark()
+		Set audit = ##class(OcuTalon.Test.Bridge.AuditLog).Now()
+		Set liveMark = ..LiveMark()
+		Set unique = "zznotoken "_##class(OcuTalon.Bridge.Ids).NewRef()
+		Set ..Texts = ""
+
+		// A rejected start.
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-getme-rejected"}), "a rejected getMe is queued")
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled")
+		Do $$$AssertTrue(..WaitState("rejected", 20), "the start is rejected")
+		Do $$$AssertStatusOK(..StopItems(), "TelegramIn is stopped")
+
+		// A 409, with its onset, and /state while the item runs.
+		Do $$$AssertStatusOK(..StartItems("TelegramIn"), "TelegramIn is enabled again")
+		Do $$$AssertTrue(..WaitState("on", 20), "the state becomes on")
+		Do $$$AssertTrue(..WaitCalls("getUpdates", 1, 20).%Size() >= 1, "a long poll is open")
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-conflict"}), "a 409 is queued")
+		Do $$$AssertTrue(..WaitMark("telegramPaused", 1, 5), "the pause mark is set")
+		Set paused = ##class(OcuTalon.Data.StatusMark).Get("telegramPaused")
+		Set onset = ..WaitEvent(since, 1)
+		Do $$$AssertTrue(onset > 0, "StatusMonitor publishes the onset")
+		Set state = ##class(OcuTalon.Web.Api).StateBody(session).%ToJSON()
+
+		// A 429 for getUpdates.
+		Do ##class(OcuTalon.Data.StatusMark).Record("telegramPaused", "")
+		Set polls = ..CallsOf("getUpdates").%Size()
+		Do $$$AssertTrue(..WaitCalls("getUpdates", polls + 1, 10).%Size() > polls, "TelegramIn polls again after the pause")
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-updates-busy"}), "a 429 for getUpdates is queued")
+		Set deadline = $ZHorolog + 10
+		For {
+			Set told = ##class(OcuTalon.Test.Agent.RunnerFixture).LogRowsHolding(log, "asked TelegramIn to wait")
+			If told || ($ZHorolog >= deadline) Quit
+			Hang 0.25
+		}
+		Do $$$AssertTrue(told > 0, "TelegramIn handled the 429")
+		Do $$$AssertStatusOK(..StopItems(), "TelegramIn is stopped again")
+
+		// A 429 for sendMessage, which ends in an error status.
+		Set ref = ##class(OcuTalon.Data.Pairing).RecordChat(8507, "", .sc)
+		Do ..Chat(8507)
+		Do $$$AssertStatusOK(sc, "the fixture chat has a row")
+		Do $$$AssertStatusOK(..StartItems("TelegramOut"), "TelegramOut is enabled")
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-rate-limited"}), "a 429 for sendMessage is queued")
+		Set message = ##class(OcuTalon.Msg.Outbound).%New()
+		Set message.ChatRef = ref
+		Set message.Text = unique
+		Do $$$AssertStatusOK(##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", message, .response), "the limited message is sent after one retry")
+		Set limited = {"status": 429, "body": {"ok": false, "error_code": 429, "description": "Too Many Requests: retry after 1", "parameters": {"retry_after": 1}}}
+		Set replies = []
+		For i = 1:1:5 Do replies.%Push(limited)
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"method": "sendMessage", "replies": (replies)}), "five 429s are queued")
+		Set message = ##class(OcuTalon.Msg.Outbound).%New()
+		Set message.ChatRef = ref
+		Set message.Text = unique_" again"
+		Set sc = ##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", message, .response)
+		Do $$$AssertStatusNotOK(sc, "five 429s end in an error status")
+		Do ..Keep(sc)
+		Do $$$AssertStatusOK(..StopItems(), "TelegramOut is stopped")
+
+		// A call to a closed port, and a call to the mock with no token.
+		Set answer = $ClassMethod(..#API, "Call", "http://127.0.0.1:1", "", "getMe", {}, 2, .code, .sc)
+		Do $$$AssertStatusNotOK(sc, "a call to a closed port is an error")
+		Do ..Keep(sc)
+		Set closed = $SYSTEM.Status.GetErrorText(sc)
+		Do $ClassMethod("OcuTalon.Test.Agent.KeyScan", "UnsetEnv", var)
+		Set base = $SYSTEM.Util.GetEnviron($Parameter(..#MOCK, "TELEGRAMBASEVAR"))
+		Set answer = $ClassMethod(..#API, "Call", base, "", "getMe", {}, 2, .code, .sc)
+		Do $ClassMethod("OcuTalon.Test.Agent.KeyScan", "SetEnv", var, token)
+		Do $$$AssertStatusNotOK(sc, "a call with no token is an error")
+		Do ..Keep(sc)
+
+		// A positive control for the audit scan: an entry of the product's own writer with a unique reason.
+		Set reason = "zz-notoken-"_$Increment(^OcuTalonTest("TelegramLive", "n"))
+		Set data = {"irisUser": "zztgtok", "sessionRef": "", "channel": "telegram", "change": "rejected", "reason": (reason)}
+		Do $$$AssertStatusOK(##class(OcuTalon.Bridge.Audit).Record("Pairing", data), "a Pairing entry is written")
+
+		// The scans.
+		Set found = ##class(OcuTalon.Test.Agent.KeyScan).Find(token)
+		Do $$$AssertEquals($ListToString(found, ", "), "", "the settings, item settings, event log and sessions hold no token")
+		Set control = ##class(OcuTalon.Test.Agent.KeyScan).Find(##class(OcuTalon.Test.Contract.Mock).#TELEGRAMBASE)
+		Do $$$AssertTrue($ListLength(control) > 0, "the key scan finds the mock's base, which the ApiBase rows hold")
+
+		Set texts = ..Texts
+		Set holds = 0, position = 0
+		While $ListNext(texts, position, text) {
+			If $Find(text, token) Set holds = holds + 1
+		}
+		Do $$$AssertEquals(holds, 0, "no %Status text holds the token")
+		Do $$$AssertTrue($Find(closed, "getMe") > 0, "and the status scan reads a text that names its method")
+
+		Set headerText = ..RowsText("SELECT * FROM Ens.MessageHeader WHERE ID > ?", headers)
+		Set bodyText = ..Bodies(headers)
+		Do $$$AssertEquals($Find(headerText, token), 0, "no message header holds the token")
+		Do $$$AssertEquals($Find(bodyText, token), 0, "no message body holds the token")
+		Do $$$AssertTrue($Find(bodyText, unique) > 0, "and the body scan reads the Outbound body of the test")
+
+		Set entries = ##class(OcuTalon.Test.Bridge.AuditLog).Wait(audit, "OcuTalon", "Pairing", "Pairing", reason, "", 1, 20)
+		Do $$$AssertEquals(entries.%Size(), 1, "the audit scan reads the entry that the test wrote")
+		Set everything = ##class(OcuTalon.Test.Bridge.AuditLog).Entries(audit).%ToJSON()
+		Do $$$AssertEquals($Find(everything, token), 0, "no audit entry since the mark holds the token")
+
+		Set liveText = ..RowsText("SELECT Payload FROM OcuTalon_Live.Event WHERE %ID > ?", liveMark)
+		Do $$$AssertEquals($Find(liveText, token), 0, "no live event since the mark holds the token")
+		Do $$$AssertTrue($Find(liveText, paused) > 0, "and the live-event scan reads the pause time of StatusMonitor's onset")
+
+		Do $$$AssertEquals($Find(state, token), 0, "the body of /state holds no token")
+		Do $$$AssertTrue($Find(state, "ocutalon_ci_bot") > 0, "and it holds the bot's name")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the token search failed: "_..Safe(ex))
+	}
+	Do $ClassMethod("OcuTalon.Test.Agent.KeyScan", "SetEnv", var, ..Token)
+	Do ..Cleanup()
+	Do $$$AssertTrue(..WaitClear(since), "StatusMonitor has published the clear of the test's pause")
+}
+
+/// The highest id of the live events: the mark that the live-event scan reads from.
+ClassMethod LiveMark() As %Integer [ Private ]
+{
+	Set result = ##class(%SQL.Statement).%ExecDirect(, "SELECT MAX(%ID) FROM OcuTalon_Live.Event")
+	Do result.%Next()
+	Quit +result.%GetData(1)
+}
+
+}
diff --git a/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramOut.cls b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramOut.cls
new file mode 100644
index 00000000..8a32cd08
--- /dev/null
+++ b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramOut.cls
@@ -0,0 +1,294 @@
+/// Live tests of TelegramOut against the CI mock (Story 12.2; FR-20, AD-14, AD-32, UX-DR108, UX-DR136). THESE TESTS RUN IN THROWAWAY
+/// STACKS AND IN CI ONLY (Rule 21), like OcuTalon.Test.Channel.LiveCase, which they extend: each test enables TelegramOut on the running
+/// production and sends its messages through RunnerFixture.Send, and ends with Cleanup. A test reads only the sendMessage calls whose
+/// chat_id it made (85xx and 86xx), because a warm stack may hold messages that other tests queued for TelegramOut.
+///   - TestPlainText: the text goes byte for byte as a numeric chat_id and plain text, with no parse_mode and no entities, also with
+///     characters beyond ASCII;
+///   - TestSplitAtLineBreaks: a text over 4,096 characters is sent in order as parts cut at line breaks, and the parts joined with a
+///     line feed are the text;
+///   - TestSplitOneLongLine: a line with no break is cut at the limit, and a surrogate pair at the limit is not split;
+///   - TestRateLimited: a 429 is retried after its retry_after, and after five 429s for one part the status is an error with a safe text
+///     while the parts already sent stay sent;
+///   - TestSentThenLimited: part 1 is sent once, part 2 is limited and sent again;
+///   - TestNotification: a Notification for a chat sends the catalog rendering, and a render error sends nothing;
+///   - TestNoChat: a ChatRef with no chat row, or none, sends nothing, logs one warning that names neither, and is OK.
+Class OcuTalon.Test.Channel.TelegramOut Extends OcuTalon.Test.Channel.LiveCase
+{
+
+/// The text that the plain-text test sends: the characters that Markdown and HTML would treat as markup.
+Parameter MARKUP = "a*b_c [x](y) `z` <b>&amp; 1.5! #t";
+
+/// A chat row of the chat id, made now and deleted by Cleanup; the ChatRef.
+Method MakeChat(chatId As %String) As %String [ Private ]
+{
+	Do ..Chat(chatId)
+	Do ..DropChats(chatId)
+	Set ref = ##class(OcuTalon.Data.Pairing).RecordChat(chatId, "", .sc)
+	Do $$$AssertStatusOK(sc, "the fixture chat "_chatId_" has a row")
+	Quit ref
+}
+
+/// The sendMessage calls whose chat_id is the id, in order.
+Method SentTo(chatId As %String) As %DynamicArray [ Private ]
+{
+	Set found = []
+	Set iterator = ..CallsOf("sendMessage").%GetIterator()
+	While iterator.%GetNext(, .call) {
+		If call.params."chat_id" = chatId Do found.%Push(call)
+	}
+	Quit found
+}
+
+/// An Outbound for the chat with the text.
+ClassMethod Outbound(chatRef As %String, text As %String) As OcuTalon.Msg.Outbound [ Private ]
+{
+	Set message = ##class(OcuTalon.Msg.Outbound).%New()
+	Set message.ChatRef = chatRef
+	Set message.Text = text
+	Quit message
+}
+
+/// The texts of calls, as a list.
+ClassMethod Texts(calls As %DynamicArray) As %List [ Private ]
+{
+	Set texts = ""
+	Set iterator = calls.%GetIterator()
+	While iterator.%GetNext(, .call) {
+		Set texts = texts _ $ListBuild(call.params.text)
+	}
+	Quit texts
+}
+
+/// The longest text of a list of texts.
+ClassMethod Longest(texts As %List) As %Integer [ Private ]
+{
+	Set longest = 0
+	Set position = 0
+	While $ListNext(texts, position, text) {
+		If $Length(text) > longest Set longest = $Length(text)
+	}
+	Quit longest
+}
+
+/// FR-20: plain text, exactly as written.
+Method TestPlainText()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set ref = ..MakeChat(8501)
+		Do $$$AssertStatusOK(..StartItems("TelegramOut"), "TelegramOut is enabled")
+		Set sc = ##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound(ref, ..#MARKUP), .response)
+		Do $$$AssertStatusOK(sc, "the message is sent")
+		Set calls = ..SentTo(8501)
+		Do $$$AssertEquals(calls.%Size(), 1, "one sendMessage")
+		If calls.%Size() = 1 {
+			Set params = calls.%Get(0).params
+			Do $$$AssertEquals(params."chat_id", 8501, "to chat 8501")
+			Do $$$AssertEquals(params.%GetTypeOf("chat_id"), "number", "as a JSON number")
+			Do $$$AssertEquals(params.text, ..#MARKUP, "with the text byte for byte")
+			Do $$$AssertEquals(params.%IsDefined("parse_mode")_"|"_params.%IsDefined("entities"), "0|0", "and no parse_mode or entities")
+		}
+		Set ref2 = ..MakeChat(8509)
+		Set accents = "caf"_$Char(233)_" "_$Char(8364)_"100 "_$Char(55357, 56832)
+		Set sc = ##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound(ref2, accents), .response)
+		Do $$$AssertStatusOK(sc, "a text beyond ASCII is sent")
+		Set calls = ..SentTo(8509)
+		Do $$$AssertEquals(calls.%Size(), 1, "one sendMessage")
+		If calls.%Size() = 1 Do $$$AssertEquals(calls.%Get(0).params.text, accents, "with the text as written")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the plain-text test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// UX-DR136: a text of over 9,000 characters is cut at line breaks.
+Method TestSplitAtLineBreaks()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set ref = ..MakeChat(8502)
+		Set text = ""
+		For i = 1:1:101 {
+			Set line = "L"_i_" "
+			Set text = text _ $Select(i = 1: "", 1: $Char(10)) _ line _ $Extract($Translate($Justify("", 89), " ", "x"), 1, 89 - $Length(line))
+		}
+		Do $$$AssertTrue($Length(text) > 9000, "the text is over 9,000 characters")
+		Do $$$AssertStatusOK(..StartItems("TelegramOut"), "TelegramOut is enabled")
+		Do $$$AssertStatusOK(##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound(ref, text), .response), "the message is sent")
+		Set calls = ..SentTo(8502)
+		Set texts = ..Texts(calls)
+		Do $$$AssertEquals(calls.%Size(), 3, "three parts")
+		Do $$$AssertTrue(..Longest(texts) <= 4096, "each is 4,096 characters or fewer")
+		Do $$$AssertEquals($ListToString(texts, $Char(10)), text, "in order, and joined with a line feed they are the text")
+		Set whole = 1, position = 0
+		While $ListNext(texts, position, part) {
+			For i = 1:1:$Length(part, $Char(10)) {
+				If $Length($Piece(part, $Char(10), i)) '= 89 Set whole = 0
+			}
+		}
+		Do $$$AssertEquals(whole, 1, "each part is cut at a line break")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the split test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// UX-DR136: a long line is cut at the limit, and a surrogate pair is not split.
+Method TestSplitOneLongLine()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set plain = ..MakeChat(8503)
+		Set paired = ..MakeChat(8504)
+		Set line = $Translate($Justify("", 9000), " ", "a")
+		Set pair = $Char(55357, 56832)
+		Set straddle = $Translate($Justify("", 4095), " ", "a")_pair_$Translate($Justify("", 5000), " ", "b")
+		Do $$$AssertStatusOK(..StartItems("TelegramOut"), "TelegramOut is enabled")
+		Do $$$AssertStatusOK(##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound(plain, line), .response), "the long line is sent")
+		Set texts = ..Texts(..SentTo(8503))
+		Do $$$AssertEquals($ListLength(texts), 3, "three parts")
+		Set lengths = ""
+		Set position = 0
+		While $ListNext(texts, position, part) {
+			Set lengths = lengths _ $ListBuild($Length(part))
+		}
+		Do $$$AssertEquals($ListToString(lengths, "|"), "4096|4096|808", "cut at the limit")
+		Do $$$AssertEquals($ListToString(texts, ""), line, "the parts joined with nothing are the line")
+		Do $$$AssertStatusOK(##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound(paired, straddle), .response), "the text with the pair at the limit is sent")
+		Set texts = ..Texts(..SentTo(8504))
+		Do $$$AssertTrue(..Longest(texts) <= 4096, "each part is 4,096 units or fewer")
+		Do $$$AssertEquals($ListToString(texts, ""), straddle, "the parts joined with nothing are the text")
+		Do $$$AssertEquals($Length($ListGet(texts, 1)), 4095, "the first part stops before the pair, so that it stays whole")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the long-line test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// UX-DR108: a 429 is retried after its retry_after, at most five tries for a part.
+Method TestRateLimited()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set ref = ..MakeChat(8505)
+		Do $$$AssertStatusOK(..StartItems("TelegramOut"), "TelegramOut is enabled")
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-rate-limited"}), "a 429 with retry_after 2 is queued")
+		Set sc = ##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound(ref, "zz limited once"), .response)
+		Do $$$AssertStatusOK(sc, "the operation returns OK")
+		Set calls = ..SentTo(8505)
+		Do $$$AssertEquals(calls.%Size(), 2, "two sendMessage calls")
+		If calls.%Size() = 2 {
+			Do $$$AssertEquals(calls.%Get(0).params.text_"|"_calls.%Get(1).params.text, "zz limited once|zz limited once", "with the same text")
+			Set gap = ..Epoch(calls.%Get(1).ts) - ..Epoch(calls.%Get(0).ts)
+			Do $$$AssertTrue(gap >= 1.95, "the second is at least 2 seconds after the first: "_$Justify(gap, 0, 2))
+		}
+		// Five 429s for the second part: the first part (a 200) stays sent, and the status is an error.
+		Set ref2 = ..MakeChat(8506)
+		Set limited = {"status": 429, "body": {"ok": false, "error_code": 429, "description": "Too Many Requests: retry after 1", "parameters": {"retry_after": 1}}}
+		Set replies = [{"status": 200, "body": {"ok": true, "result": {"message_id": 1, "date": 0, "chat": {"id": 8506, "type": "private"}, "text": "part"}}}]
+		For i = 1:1:5 Do replies.%Push(limited)
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"method": "sendMessage", "replies": (replies)}), "a 200 and five 429s are queued")
+		Set text = $Translate($Justify("", 3000), " ", "a")_$Char(10)_$Translate($Justify("", 3000), " ", "b")
+		Set sc = ##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound(ref2, text), .response)
+		Do $$$AssertStatusNotOK(sc, "after five 429s for one part the status is an error")
+		Set message = $SYSTEM.Status.GetErrorText(sc)
+		Do $$$AssertEquals($Find(message, ..Token), 0, "whose text holds no token")
+		Do $$$AssertTrue($Find(message, "429") > 0, "and says what Telegram answered")
+		Set calls = ..SentTo(8506)
+		Do $$$AssertEquals(calls.%Size(), 6, "the first part was sent once and the second five times")
+		If calls.%Size() = 6 {
+			Set first = calls.%Get(0).params.text, second = calls.%Get(1).params.text
+			Do $$$AssertEquals(($Extract(first, 1) = "a")_"|"_($Extract(second, 1) = "b"), "1|1", "part 1 first, then part 2")
+			Set same = 1
+			For i = 2:1:5 If calls.%Get(i).params.text '= second Set same = 0
+			Do $$$AssertEquals(same, 1, "every retry sends the same part 2, and part 1 is not sent again")
+		}
+	} Catch ex {
+		Do $$$AssertTrue(0, "the rate-limit test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// UX-DR108: a 429 on the second part resends that part only.
+Method TestSentThenLimited()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set ref = ..MakeChat(8601)
+		Do $$$AssertStatusOK(..StartItems("TelegramOut"), "TelegramOut is enabled")
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-sent-then-limited"}), "a 200 and then a 429 with retry_after 1 are queued")
+		Set one = $Translate($Justify("", 3000), " ", "a")
+		Set two = $Translate($Justify("", 3000), " ", "b")
+		Set sc = ##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound(ref, one_$Char(10)_two), .response)
+		Do $$$AssertStatusOK(sc, "the operation returns OK")
+		Set calls = ..SentTo(8601)
+		Do $$$AssertEquals(calls.%Size(), 3, "three calls")
+		If calls.%Size() = 3 {
+			Do $$$AssertEquals(calls.%Get(0).params.text = one, 1, "part 1 first")
+			Do $$$AssertEquals(calls.%Get(1).params.text = two, 1, "then part 2")
+			Do $$$AssertEquals(calls.%Get(2).params.text = two, 1, "and part 2 again, never part 1")
+			Set gap = ..Epoch(calls.%Get(2).ts) - ..Epoch(calls.%Get(1).ts)
+			Do $$$AssertTrue(gap >= 0.95, "at least a second later: "_$Justify(gap, 0, 2))
+		}
+	} Catch ex {
+		Do $$$AssertTrue(0, "the second-part test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// AD-32: a Notification for a chat is rendered from its catalog key; a render error sends nothing.
+Method TestNotification()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Set ref = ..MakeChat(8508)
+		Set message = ##class(OcuTalon.Msg.Notification).%New()
+		Set message.ChatRef = ref
+		Set message.Kind = "pairing"
+		Set message.CatalogKey = "pairing.paired"
+		Set expected = ##class(OcuTalon.Msg.Catalog).Render("pairing.paired", "", "telegram", .sc)
+		Do $$$AssertStatusOK(sc, "the catalog renders the key")
+		Do $$$AssertStatusOK(..StartItems("TelegramOut"), "TelegramOut is enabled")
+		Do $$$AssertStatusOK(##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", message, .response), "the notification is sent")
+		Set calls = ..SentTo(8508)
+		Do $$$AssertEquals(calls.%Size(), 1, "one sendMessage")
+		If calls.%Size() = 1 Do $$$AssertEquals(calls.%Get(0).params.text, expected, "with the catalog text for Telegram")
+		Set bad = ##class(OcuTalon.Msg.Notification).%New()
+		Set bad.ChatRef = ref
+		Set bad.Kind = "pairing"
+		Set bad.CatalogKey = "zz.noSuchKey"
+		Do $$$AssertStatusNotOK(##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", bad, .response), "a key that cannot be rendered is an error status")
+		Do $$$AssertEquals(..SentTo(8508).%Size(), 1, "and nothing more is sent")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the notification test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+/// A ChatRef with no chat row, and no ChatRef: no call, one warning that names neither, and OK.
+Method TestNoChat()
+{
+	If '..ReadyLive() Quit
+	Try {
+		Do $$$AssertStatusOK(..StartItems("TelegramOut"), "TelegramOut is enabled")
+		Set log = ##class(OcuTalon.Test.Agent.RunnerFixture).EventMark()
+		Set before = ..CallsOf("sendMessage").%Size()
+		Set unknown = "zznochat1234567"
+		Do $$$AssertStatusOK(##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound(unknown, "zz nobody"), .response), "a ChatRef with no row is OK")
+		Do $$$AssertStatusOK(##class(OcuTalon.Test.Agent.RunnerFixture).Send("TelegramOut", ..Outbound("", "zz nobody"), .response), "no ChatRef is OK")
+		Do $$$AssertEquals(..CallsOf("sendMessage").%Size(), before, "no call is made")
+		Set rows = ##class(OcuTalon.Test.Agent.RunnerFixture).EventRows(log, "TelegramOut")
+		Set told = 0, names = 0, position = 0
+		While $ListNext(rows, position, row) {
+			If ($Extract(row, 1, 2) = "3:") && ($Find(row, "names no known Telegram chat") > 0) Set told = told + 1
+			If $Find(row, unknown) > 0 Set names = names + 1
+		}
+		Do $$$AssertEquals(told, 2, "one warning for each message")
+		Do $$$AssertEquals(names, 0, "and no warning names the Ref")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the no-chat test failed: "_..Safe(ex))
+	}
+	Do ..Cleanup()
+}
+
+}
diff --git a/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramPause.cls b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramPause.cls
new file mode 100644
index 00000000..a599f9a3
--- /dev/null
+++ b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramPause.cls
@@ -0,0 +1,174 @@
+/// Live tests of the 409 pause of TelegramIn against the CI mock and the production's own StatusMonitor (Story 12.2; FR-22, AD-12, AD-14,
+/// AD-18). THESE TESTS RUN IN THROWAWAY STACKS AND IN CI ONLY (Rule 21), like OcuTalon.Test.Channel.LiveCase, which they extend, and they follow
+/// OcuTalon.Test.Schedule.Stalled: StateBody's status members, and the status events that StatusMonitor's job publishes on the instance
+/// stream after InstanceSeq. A test stands in for elapsed time by moving the telegramPaused mark. Each test waits for StatusMonitor's job to
+/// pass its silent first run, and, after its Cleanup, for its own clear, so that no telegramPaused event lands in a later test's window.
+///   - TestPause409: a 409 sets the mark 300 s ahead within 2 s, no getUpdates follows in 4 s, one warning names the pause and its time,
+///     StateBody holds telegramPaused active with that time, and StatusMonitor publishes the onset;
+///   - TestResumeSucceeds: no poll before the mark's time, the first 200 deletes the mark, StateBody holds no telegramPaused, and StatusMonitor
+///     publishes the clear with no telegramPaused event between the onset and the clear;
+///   - TestResumeMeetsAnother409: the first poll after the mark gets a queued 409, and the mark is 300 s ahead again.
+Class OcuTalon.Test.Channel.TelegramPause Extends OcuTalon.Test.Channel.LiveCase
+{
+
+/// The mark of the pause.
+Parameter MARK = "telegramPaused";
+
+/// The number of telegramPaused events with a Seq above from and below to.
+ClassMethod Count(from As %Integer, to As %Integer) As %Integer [ Private ]
+{
+	Set count = 0
+	Set events = ..Events(from)
+	Set iterator = events.%GetIterator()
+	While iterator.%GetNext(, .event) {
+		If event.seq < to Set count = count + 1
+	}
+	Quit count
+}
+
+/// The telegramPaused members of StateBody's status array.
+ClassMethod Members(session As OcuTalon.Data.Session) As %DynamicArray [ Private ]
+{
+	Set members = []
+	Set iterator = ##class(OcuTalon.Web.Api).StateBody(session).status.%GetIterator()
+	While iterator.%GetNext(, .condition) {
+		If condition.condition = "telegramPaused" Do members.%Push(condition)
+	}
+	Quit members
+}
+
+/// The seconds that a UTC time is ahead of now (negative when it is behind).
+ClassMethod Ahead(utc As %String) As %Integer [ Private ]
+{
+	Quit ##class(OcuTalon.Data.Time).Seconds(utc) - ##class(OcuTalon.Data.Time).Seconds(##class(OcuTalon.Data.Time).NowUtc())
+}
+
+/// Starts TelegramIn, waits until a long poll is open, and queues the 409; returns the time of the queueing. 0 when the item did not start.
+Method StartAndConflict() As %Numeric [ Private ]
+{
+	Set sc = ..StartItems("TelegramIn")
+	Do $$$AssertStatusOK(sc, "TelegramIn is enabled")
+	If $$$ISERR(sc) Quit 0
+	Do $$$AssertTrue(..WaitState("on", 20), "the state becomes on")
+	Do $$$AssertTrue(..WaitCalls("getUpdates", 1, 20).%Size() >= 1, "a long poll is open")
+	Set queuedAt = ..EpochNow()
+	Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-conflict"}), "a 409 is queued while the poll is open")
+	Quit queuedAt
+}
+
+/// The ending of a pause test: the usual Cleanup, and then the wait for the test's own clear.
+Method Ending(since As %Integer) [ Private ]
+{
+	Do ..Cleanup()
+	Do $$$AssertTrue(..WaitClear(since), "StatusMonitor has published the clear of the test's pause")
+}
+
+/// FR-22: a 409 pauses for 5 minutes, records the time, logs it, and turns on telegramPaused for /state and StatusMonitor.
+Method TestPause409()
+{
+	If '..ReadyLive() Quit
+	Set since = ..InstanceSeq()
+	Try {
+		Set session = ..FixtureSession("zztgpause")
+		Set log = ##class(OcuTalon.Test.Agent.RunnerFixture).EventMark()
+		Do $$$AssertTrue(..WaitMonitor(), "StatusMonitor's job is past its silent first run")
+		Set since = ..InstanceSeq()
+		Set queuedAt = ..StartAndConflict()
+		Do $$$AssertTrue(queuedAt > 0, "the conflict is queued")
+		Do $$$AssertTrue(..WaitMark(..#MARK, 1, 2), "within 2 seconds the pause mark is set")
+		Set mark = ##class(OcuTalon.Data.StatusMark).Get(..#MARK)
+		Do $$$AssertTrue($ZAbs(..Ahead(mark) - 300) <= 5, "it is a UTC time 300 seconds ahead, within 5: "_..Ahead(mark))
+		Set polls = ..CallsOf("getUpdates").%Size()
+		Hang 4
+		Do $$$AssertEquals(..CallsOf("getUpdates").%Size(), polls, "no getUpdates follows in the next 4 seconds")
+		Set rows = ##class(OcuTalon.Test.Agent.RunnerFixture).EventRows(log, "TelegramIn")
+		Set told = 0, position = 0
+		While $ListNext(rows, position, row) {
+			If ($Extract(row, 1, 2) = "3:") && ($Find(row, "pauses until "_mark) > 0) Set told = told + 1
+		}
+		Do $$$AssertEquals(told, 1, "one warning names the pause and its time")
+		Do $$$AssertEquals(##class(OcuTalon.Test.Agent.RunnerFixture).LogRowsHolding(log, ..Token), 0, "no log row holds the token")
+		Set members = ..Members(session)
+		Do $$$AssertEquals(members.%Size(), 1, "StateBody holds one telegramPaused member")
+		Set expected = {"condition": "telegramPaused", "active": true, "slots": {"time": (mark)}}.%ToJSON()
+		If members.%Size() = 1 Do $$$AssertEquals(members.%Get(0).%ToJSON(), expected, "active, with the mark's time")
+		Set onset = ..WaitEvent(since, 1)
+		Do $$$AssertTrue(onset > 0, "StatusMonitor publishes the onset within 30 seconds")
+		If onset > 0 {
+			Set events = ..Events(since)
+			If events.%Size() '= 0 Do $$$AssertEquals(events.%Get(0).payload.%ToJSON(), expected, "with the mark's time as its payload")
+		}
+	} Catch ex {
+		Do $$$AssertTrue(0, "the pause test failed: "_..Safe(ex))
+	}
+	Do ..Ending(since)
+}
+
+/// FR-22: the pause has run out, so the poll succeeds, the mark is deleted and StatusMonitor publishes the clear.
+Method TestResumeSucceeds()
+{
+	If '..ReadyLive() Quit
+	Set since = ..InstanceSeq()
+	Try {
+		Set session = ..FixtureSession("zztgpause")
+		Do $$$AssertTrue(..WaitMonitor(), "StatusMonitor's job is past its silent first run")
+		Set since = ..InstanceSeq()
+		Do $$$AssertTrue(..StartAndConflict() > 0, "the conflict is queued")
+		Do $$$AssertTrue(..WaitMark(..#MARK, 1, 5), "the pause mark is set")
+		Set onset = ..WaitEvent(since, 1)
+		Do $$$AssertTrue(onset > 0, "StatusMonitor has published the onset")
+		Set until = ##class(OcuTalon.Data.Time).AddSeconds(##class(OcuTalon.Data.Time).NowUtc(), 2)
+		Do $$$AssertStatusOK(##class(OcuTalon.Data.StatusMark).Record(..#MARK, until), "the mark is moved to 2 seconds ahead")
+		Set polls = ..CallsOf("getUpdates").%Size()
+		Do $$$AssertTrue(..WaitMark(..#MARK, 0, 15), "the first 200 deletes the mark")
+		Set after = ..CallsOf("getUpdates")
+		Do $$$AssertTrue(after.%Size() > polls, "TelegramIn polled again")
+		If after.%Size() > polls {
+			Do $$$AssertTrue(..Epoch(after.%Get(polls).ts) >= (##class(OcuTalon.Data.Time).Seconds(until) - 0.05), "and not before the mark's time")
+		}
+		Do $$$AssertEquals(..Members(session).%Size(), 0, "StateBody holds no telegramPaused")
+		Set clear = ..WaitEvent(onset, 0)
+		Do $$$AssertTrue(clear > 0, "StatusMonitor publishes the clear within 30 seconds")
+		If clear > 0 Do $$$AssertEquals(..Count(onset, clear), 0, "with no telegramPaused event between the onset and the clear")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the resume test failed: "_..Safe(ex))
+	}
+	Do ..Ending(since)
+}
+
+/// FR-22: the first poll after the mark gets another 409, so the pause is 5 minutes again.
+Method TestResumeMeetsAnother409()
+{
+	If '..ReadyLive() Quit
+	Set since = ..InstanceSeq()
+	Try {
+		Do $$$AssertTrue(..WaitMonitor(), "StatusMonitor's job is past its silent first run")
+		Set since = ..InstanceSeq()
+		Do $$$AssertTrue(..StartAndConflict() > 0, "the conflict is queued")
+		Do $$$AssertTrue(..WaitMark(..#MARK, 1, 5), "the pause mark is set")
+		Set until = ##class(OcuTalon.Data.Time).AddSeconds(##class(OcuTalon.Data.Time).NowUtc(), 2)
+		Do $$$AssertStatusOK(##class(OcuTalon.Data.StatusMark).Record(..#MARK, until), "the mark is moved to 2 seconds ahead")
+		Do $$$AssertTrue(##class(OcuTalon.Test.Contract.Mock).Control("replies", {"scenario": "telegram-conflict"}), "another 409 is queued during the pause")
+		Set polls = ..CallsOf("getUpdates").%Size()
+		Set deadline = $ZHorolog + 15
+		For {
+			Set mark = ##class(OcuTalon.Data.StatusMark).Get(..#MARK)
+			If (mark '= until) || ($ZHorolog >= deadline) Quit
+			Hang 0.25
+		}
+		Do $$$AssertTrue(mark '= until, "the mark was written again")
+		Do $$$AssertTrue($ZAbs(..Ahead(mark) - 300) <= 5, "it is 300 seconds ahead again: "_..Ahead(mark))
+		Set after = ..CallsOf("getUpdates")
+		Do $$$AssertEquals(after.%Size(), polls + 1, "exactly one poll was made, and it got the 409")
+		If after.%Size() > polls {
+			Do $$$AssertTrue(..Epoch(after.%Get(polls).ts) >= (##class(OcuTalon.Data.Time).Seconds(until) - 0.05), "after the mark's time, not during the pause")
+		}
+		Hang 3
+		Do $$$AssertEquals(..CallsOf("getUpdates").%Size(), polls + 1, "and no poll follows")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the re-pause test failed: "_..Safe(ex))
+	}
+	Do ..Ending(since)
+}
+
+}
diff --git a/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramSettings.cls b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramSettings.cls
new file mode 100644
index 00000000..77962e9d
--- /dev/null
+++ b/src/ocutalon/cls/OcuTalon/Test/Channel/TelegramSettings.cls
@@ -0,0 +1,289 @@
+/// Tests of the Telegram endpoint settings and of the client SSL configuration (Story 12.2; AD-19, AD-23, NFR-11, U-164). THESE TESTS RUN
+/// IN FRESH THROWAWAY STACKS AND IN CI ONLY (Rule 21), never warm and never on a dev slot, because they change the SSL configuration
+/// OcuTalonClient in %SYS; each puts back what it changed.
+///   - TestEndpointSettings: the ApiBase rows of both items hold the base of OCUTALON_TELEGRAM_API_BASE (the public API when it is empty),
+///     Install.Step.Telegram.Base writes both, a row changed by hand is written again by Run(), and both items resolve SSLConfig to
+///     OcuTalonClient;
+///   - TestSSLConfiguration: OcuTalonClient exists as an enabled client configuration that verifies the peer against the OS store, and
+///     the SSL step puts back a value changed by hand (VerifyPeer), and creates it when it is absent;
+///   - TestCAFileInImage (U-164 condition 1): the CA bundle that the OS store stands for exists in this image and holds certificates;
+///   - TestBadCertificateRefused (U-164 condition 1): a disposable TLS server with a self-signed certificate, started by the test in its
+///     own container on a loopback port, answers a client configuration that trusts its certificate and is refused by OcuTalonClient.
+Class OcuTalon.Test.Channel.TelegramSettings Extends %UnitTest.TestCase
+{
+
+Parameter PRODUCTION = "OcuTalon.Production";
+
+Parameter STEP = "OcuTalon.Install.Step.Telegram";
+
+Parameter SSLSTEP = "OcuTalon.Install.Step.SSL";
+
+Parameter API = "OcuTalon.Channel.Telegram.Api";
+
+Parameter FIXTURE = "OcuTalon.Test.Agent.RunnerFixture";
+
+/// The rows saved by a test: a list of RunnerFixture snapshots.
+Property Rows As %String(MAXLEN = "") [ Private ];
+
+/// The Telegram state mark as found.
+Property MarkFound As %String(MAXLEN = "") [ Private ];
+
+/// The seam ^OcuTalonTest("TelegramIncluded") as found: $Data and the value.
+Property SeamData As %Integer [ Private ];
+
+Property SeamValue As %String [ Private ];
+
+/// 1 when this stack may be changed: a throwaway with the mock (the CI override sets the Bot API base).
+Method Guard() As %Boolean [ Private ]
+{
+	Set mock = "OcuTalon.Test.Contract.Mock"
+	Set reason = $ClassMethod(mock, "TelegramMissingReason", $SYSTEM.Util.GetEnviron($Parameter(mock, "TELEGRAMBASEVAR")), $SYSTEM.Util.GetEnviron($Parameter(mock, "TELEGRAMTOKENVAR")))
+	If reason '= "" {
+		Do $$$AssertTrue(0, reason)
+		Quit 0
+	}
+	Set reason = $ClassMethod(..#FIXTURE, "RunningReason")
+	If reason '= "" Do $$$AssertTrue(0, reason)
+	Quit reason = ""
+}
+
+/// Saves the four rows that Run() writes, the mark and the seam.
+Method Save() [ Private ]
+{
+	Set rows = ""
+	For item = "TelegramIn", "TelegramOut" {
+		For setting = "Enabled", "ApiBase" {
+			Do $ClassMethod(..#FIXTURE, "RememberDefault", .rows, item, setting)
+		}
+	}
+	Set ..Rows = rows
+	Set ..MarkFound = ##class(OcuTalon.Data.StatusMark).Get(##class(OcuTalon.Data.StatusMark).#TELEGRAMMARK)
+	Set ..SeamData = $Data(^OcuTalonTest("TelegramIncluded"))
+	Set ..SeamValue = $Get(^OcuTalonTest("TelegramIncluded"))
+}
+
+/// Puts the saved rows, the mark and the seam back.
+Method Restore() [ Private ]
+{
+	Do $$$AssertStatusOK($ClassMethod(..#FIXTURE, "RestoreDefaults", ..Rows), "the Enabled and ApiBase rows are put back")
+	Do ##class(OcuTalon.Data.StatusMark).Record(##class(OcuTalon.Data.StatusMark).#TELEGRAMMARK, ..MarkFound)
+	If ..SeamData {
+		Set ^OcuTalonTest("TelegramIncluded") = ..SeamValue
+	} Else {
+		Kill ^OcuTalonTest("TelegramIncluded")
+	}
+}
+
+/// What the ApiBase row of the item holds, or "-" when there is none.
+Method Row(item As %String) As %String [ Private ]
+{
+	Set id = ..#PRODUCTION_"||"_item_"||*||ApiBase"
+	If '##class(Ens.Config.DefaultSettings).%ExistsId(id) Quit "-"
+	Quit ##class(Ens.Config.DefaultSettings).%OpenId(id).SettingValue
+}
+
+/// The base that a start writes: the variable's value, or the public API.
+Method Expected() As %String [ Private ]
+{
+	Set value = $SYSTEM.Util.GetEnviron($Parameter(..#API, "BASEVAR"))
+	Quit $Select(value = "": $Parameter(..#API, "PUBLICBASE"), 1: value)
+}
+
+/// The ApiBase rows, Base(), Run() and the SSLConfig default.
+Method TestEndpointSettings()
+{
+	If '..Guard() Quit
+	Do ..Save()
+	Try {
+		Set expected = ..Expected()
+		Do $$$AssertEquals(..Row("TelegramIn")_"|"_..Row("TelegramOut"), expected_"|"_expected, "a start wrote the ApiBase row of both items from the environment")
+		Do $$$AssertStatusOK($ClassMethod(..#STEP, "Base", ""), "Base with an empty value succeeds")
+		Set public = $Parameter(..#API, "PUBLICBASE")
+		Do $$$AssertEquals(..Row("TelegramIn")_"|"_..Row("TelegramOut"), public_"|"_public, "both rows hold the public API")
+		Do $$$AssertStatusOK($ClassMethod(..#STEP, "Base", "http://mock:8080"), "Base with a value succeeds")
+		Do $$$AssertEquals(..Row("TelegramIn")_"|"_..Row("TelegramOut"), "http://mock:8080|http://mock:8080", "both rows hold the value")
+		Do $$$AssertStatusOK($ClassMethod(..#FIXTURE, "PutDefault", "TelegramIn", "ApiBase", "http://zz-by-hand:1"), "a row is changed by hand")
+		Do ##class(OcuTalon.Test.Data.Fixture).SetTelegramIncluded(0)
+		Do $$$AssertStatusOK($ClassMethod(..#STEP, "Run"), "Run succeeds")
+		Do $$$AssertEquals(..Row("TelegramIn")_"|"_..Row("TelegramOut"), expected_"|"_expected, "and writes the row again")
+		For item = "TelegramIn", "TelegramOut" {
+			Set host = ##class(Ens.Host).GetShadowInstance(..#PRODUCTION_"||"_item, .sc)
+			Do $$$AssertStatusOK(sc, item_": the item is resolved")
+			If $IsObject(host) {
+				Do $$$AssertEquals(host.SSLConfig, "OcuTalonClient", item_" resolves SSLConfig to OcuTalonClient")
+				Do $$$AssertEquals(host.ApiBase, expected, item_" resolves ApiBase to the row")
+			}
+		}
+	} Catch ex {
+		Do $$$AssertTrue(0, "the endpoint test failed: "_$Translate(ex.DisplayString(), $Char(13, 10), "  "))
+	}
+	Do ..Restore()
+}
+
+/// The properties of OcuTalonClient, as "type|enabled|verify|CA file", or "" when it is absent.
+ClassMethod Client() As %String [ Private ]
+{
+	New $Namespace
+	Set $Namespace = "%SYS"
+	Kill properties
+	If '##class(Security.SSLConfigs).Exists("OcuTalonClient") Quit ""
+	If $$$ISERR(##class(Security.SSLConfigs).Get("OcuTalonClient", .properties)) Quit "-"
+	Quit properties("Type")_"|"_properties("Enabled")_"|"_properties("VerifyPeer")_"|"_properties("CAFile")
+}
+
+/// Changes a property of OcuTalonClient (in %SYS).
+ClassMethod Change(property As %String, value As %String) As %Status [ Private ]
+{
+	New $Namespace
+	Set $Namespace = "%SYS"
+	Kill properties
+	Set properties(property) = value
+	Quit ##class(Security.SSLConfigs).Modify("OcuTalonClient", .properties)
+}
+
+/// Deletes OcuTalonClient (in %SYS).
+ClassMethod Drop() As %Status [ Private ]
+{
+	New $Namespace
+	Set $Namespace = "%SYS"
+	Quit ##class(Security.SSLConfigs).Delete("OcuTalonClient")
+}
+
+/// OcuTalonClient: a client configuration that verifies the peer against the OS store, kept by the SSL step.
+Method TestSSLConfiguration()
+{
+	If '..Guard() Quit
+	Try {
+		Do $$$AssertEquals(..Client(), "0|1|1|%OSCertificateStore", "OcuTalonClient exists: client, enabled, VerifyPeer 1, the OS store")
+		Do $$$AssertStatusOK(..Change("VerifyPeer", 0), "VerifyPeer is set to 0 by hand")
+		Do $$$AssertEquals(..Client(), "0|1|0|%OSCertificateStore", "and it holds 0")
+		Do $$$AssertStatusOK($ClassMethod(..#SSLSTEP, "Run"), "the SSL step runs")
+		Do $$$AssertEquals(..Client(), "0|1|1|%OSCertificateStore", "and puts VerifyPeer back to 1")
+		Do $$$AssertStatusOK(..Change("Enabled", 0), "the configuration is disabled by hand")
+		Do $$$AssertStatusOK($ClassMethod(..#SSLSTEP, "Run"), "the SSL step runs")
+		Do $$$AssertEquals(..Client(), "0|1|1|%OSCertificateStore", "and enables it")
+		Do $$$AssertStatusOK(..Drop(), "the configuration is deleted")
+		Do $$$AssertEquals(..Client(), "", "and is absent")
+		Do $$$AssertStatusOK($ClassMethod(..#SSLSTEP, "Run"), "the SSL step runs")
+		Do $$$AssertEquals(..Client(), "0|1|1|%OSCertificateStore", "and creates it")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the SSL test failed: "_$Translate(ex.DisplayString(), $Char(13, 10), "  "))
+	}
+	If ..Client() '= "0|1|1|%OSCertificateStore" Do $ClassMethod(..#SSLSTEP, "Run")
+}
+
+/// The CA bundles an Ubuntu image keeps for the OS store, the first that exists.
+Parameter BUNDLE = "/etc/ssl/certs/ca-certificates.crt";
+
+/// OpenSSL's default bundle, which the OS store stands for on Linux.
+Parameter DEFAULTBUNDLE = "/usr/lib/ssl/cert.pem";
+
+/// The number of certificates in a PEM file, or -1 when the file cannot be read.
+ClassMethod Certificates(file As %String) As %Integer [ Private ]
+{
+	If '##class(%File).Exists(file) Quit -1
+	Set stream = ##class(%Stream.FileCharacter).%New()
+	Do stream.LinkToFile(file)
+	Set count = 0
+	While 'stream.AtEnd {
+		If $Extract(stream.ReadLine(), 1, 27) = "-----BEGIN CERTIFICATE-----" Set count = count + 1
+	}
+	Quit count
+}
+
+/// U-164 condition 1: the CA bundle that OcuTalonClient's OS store stands for exists in this image, and holds certificates.
+Method TestCAFileInImage()
+{
+	Do $$$AssertEquals(..Client(), "0|1|1|%OSCertificateStore", "OcuTalonClient names the OS store")
+	Do $$$AssertTrue(..Certificates(..#BUNDLE) > 50, "the image's CA bundle "_..#BUNDLE_" exists and holds certificates: "_..Certificates(..#BUNDLE))
+	Do $$$AssertEquals(..Certificates(..#DEFAULTBUNDLE), ..Certificates(..#BUNDLE), "OpenSSL's default bundle "_..#DEFAULTBUNDLE_" leads to the same file")
+}
+
+/// The disposable TLS server of TestBadCertificateRefused: a self-signed certificate that the test makes, and openssl s_server on a
+/// loopback port, both in a temporary folder of this container. 1 when it started; dir, port and cert say where.
+Method StartServer(Output dir As %String, Output port As %Integer, Output cert As %String) As %Boolean [ Private ]
+{
+	Set dir = ##class(%File).TempFilename("d")
+	Do ##class(%File).Delete(dir)
+	Set dir = dir_"/"
+	If '##class(%File).CreateDirectoryChain(dir) Quit 0
+	Set cert = dir_"cert.pem"
+	Set key = dir_"key.pem"
+	Set made = $ZF(-100, "", "openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", key, "-out", cert, "-subj", "/CN=ocutalon-test", "-days", "1", "-addext", "subjectAltName=IP:127.0.0.1")
+	If made '= 0 Quit 0
+	Set port = 40000 + $Random(10000)
+	Set script = "echo $$ > "_dir_"pid; exec openssl s_server -accept 127.0.0.1:"_port_" -cert "_cert_" -key "_key_" -www -quiet"
+	Quit $ZF(-100, "/ASYNC", "sh", "-c", script) = 0
+}
+
+/// Stops the server and removes its folder.
+Method StopServer(dir As %String) [ Private ]
+{
+	If dir = "" Quit
+	If ##class(%File).Exists(dir_"pid") {
+		Set stream = ##class(%Stream.FileCharacter).%New()
+		Do stream.LinkToFile(dir_"pid")
+		Set pid = $ZStrip(stream.ReadLine(), "<>W")
+		Kill stream
+		If pid ? 1.N Do $ZF(-100, "", "kill", pid)
+	}
+	Do ##class(%File).RemoveDirectoryTree(dir)
+}
+
+/// A GET of the server over TLS with the SSL configuration; the status is the request's, and code is the HTTP status or "".
+ClassMethod Get(port As %Integer, config As %String, Output code As %String) As %Status [ Private ]
+{
+	Set request = ##class(%Net.HttpRequest).%New()
+	Set request.Server = "127.0.0.1"
+	Set request.Port = port
+	Set request.Https = 1
+	Set request.SSLConfiguration = config
+	Set request.Timeout = 5
+	Set sc = request.Get("/")
+	Set code = $Select($IsObject(request.HttpResponse): request.HttpResponse.StatusCode, 1: "")
+	Quit sc
+}
+
+/// Makes the throwaway client configuration ZzTrustTest, which trusts the file (in %SYS); deletes it for a file of "".
+ClassMethod Trust(file As %String) As %Status [ Private ]
+{
+	New $Namespace
+	Set $Namespace = "%SYS"
+	If file = "" Quit $Select(##class(Security.SSLConfigs).Exists("ZzTrustTest"): ##class(Security.SSLConfigs).Delete("ZzTrustTest"), 1: $$$OK)
+	Kill properties
+	Set properties("Type") = 0
+	Set properties("Enabled") = 1
+	Set properties("VerifyPeer") = 1
+	Set properties("CAFile") = file
+	Quit $Select(##class(Security.SSLConfigs).Exists("ZzTrustTest"): ##class(Security.SSLConfigs).Modify("ZzTrustTest", .properties), 1: ##class(Security.SSLConfigs).Create("ZzTrustTest", .properties))
+}
+
+/// U-164 condition 1: a request through OcuTalonClient to a TLS server with a bad certificate (self-signed, started here, in this
+/// container, on a loopback port) is refused. The control: the same server answers a client configuration that trusts its certificate,
+/// so the refusal is the verification, not a broken server.
+Method TestBadCertificateRefused()
+{
+	If '..Guard() Quit
+	Set dir = ""
+	Try {
+		Do $$$AssertTrue(..StartServer(.dir, .port, .cert), "the disposable TLS server is started on a loopback port")
+		Do $$$AssertStatusOK(..Trust(cert), "a client configuration that trusts the server's certificate is made")
+		Set deadline = $ZHorolog + 15
+		For {
+			Set sc = ..Get(port, "ZzTrustTest", .code)
+			If $$$ISOK(sc) || ($ZHorolog >= deadline) Quit
+			Hang 0.5
+		}
+		Do $$$AssertStatusOK(sc, "the server answers a client that trusts its certificate")
+		Do $$$AssertEquals(code, 200, "with HTTP 200")
+		Set sc = ..Get(port, "OcuTalonClient", .code)
+		Do $$$AssertStatusNotOK(sc, "OcuTalonClient refuses the server's self-signed certificate")
+		Do $$$AssertEquals(code, "", "and no HTTP answer was read")
+	} Catch ex {
+		Do $$$AssertTrue(0, "the bad-certificate test failed: "_$Translate(ex.DisplayString(), $Char(13, 10), "  "))
+	}
+	Do ..StopServer(dir)
+	Do $$$AssertStatusOK(..Trust(""), "the test's client configuration is deleted")
+}
+
+}
