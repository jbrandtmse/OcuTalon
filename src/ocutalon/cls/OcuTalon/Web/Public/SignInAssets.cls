/// The sign-in page's inline stylesheet and script, generated by web/scripts/tokens.mjs from DESIGN.md,
/// web/src/signin/signin.css and web/src/signin/signin.js. Never edited by hand: npm --prefix web run tokens rewrites it.
/// Login hashes both parameters for its Content-Security-Policy header.
Class OcuTalon.Web.Public.SignInAssets
{

/// The minified stylesheet: the custom properties it uses (light, then dark through prefers-color-scheme), then its rules.
Parameter CSS = ":root{--surface:#FFFFFF;--border:#D3DCE5;--border-strong:#76879B;--ink:#102A45;--ink-muted:#4A5C72;--action:#1A6F6D;--action-hover:#145958;--on-action:#FFFFFF;--action-ink:#1A6F6D;--action-soft:#E3F2F1;--danger-ink:#B42318;--focus:#1A6F6D;--type-display-lg-font-size:28px;--type-display-lg-font-weight:700;--type-display-lg-line-height:1.2;--type-display-lg-letter-spacing:-0.01em;--type-body-font-size:14px;--type-body-line-height:1.5;--type-body-strong-font-size:14px;--type-body-strong-font-weight:600;--type-body-strong-line-height:1.5;--type-body-sm-font-size:13px;--type-body-sm-line-height:1.45;--rounded-xs:4px;--rounded-sm:6px;--rounded-md:10px;--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-6:24px;--space-control-height:36px;--space-control-height-lg:40px;--space-target-min:32px;--space-sign-in-card-width:400px;--splash-canvas-background:#FFFFFF}@media(prefers-color-scheme:dark){:root{--surface:#18233A;--border:#2E3D5A;--border-strong:#6B7C99;--ink:#EEF2F7;--ink-muted:#AAB6C8;--action:#45B9B3;--action-hover:#5FC7C1;--on-action:#0B1220;--action-ink:#5CC9C3;--action-soft:#173A43;--danger-ink:#F7867B;--focus:#5CC9C3;--splash-canvas-background:#11192B}}:root{color-scheme:light dark}*,*::before,*::after{box-sizing:border-box}html{background:var(--splash-canvas-background)}body{margin:0;min-height:100vh;background:var(--splash-canvas-background);color:var(--ink);font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:var(--type-body-font-size);line-height:var(--type-body-line-height)}.page{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:var(--space-6)}.logo{display:block;width:320px;max-width:100%;height:auto;margin:0 auto -4px}.card{width:var(--space-sign-in-card-width);max-width:100%;padding:var(--space-6);background:var(--surface);border:1px solid var(--border);border-radius:var(--rounded-md)}.card h1{margin:0 0 var(--space-4);color:var(--ink);font-size:var(--type-display-lg-font-size);font-weight:var(--type-display-lg-font-weight);line-height:var(--type-display-lg-line-height);letter-spacing:var(--type-display-lg-letter-spacing)}.field + .field{margin-top:var(--space-3)}.label{display:block;margin:0 0 var(--space-1);color:var(--ink);font-size:var(--type-body-strong-font-size);font-weight:var(--type-body-strong-font-weight);line-height:var(--type-body-strong-line-height)}.input{display:flex;align-items:center;gap:var(--space-1);min-height:var(--space-control-height-lg);padding:0 3px 0 var(--space-3);background:var(--surface);border:1px solid var(--border-strong);border-radius:var(--rounded-xs)}.input.invalid{border-color:var(--danger-ink)}.input:focus-within,.error:focus,.toggle:focus-visible,.primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px;box-shadow:0 0 0 2px var(--surface)}.input input{flex:1;min-width:0;min-height:38px;border:0;padding:0;background:transparent;color:var(--ink);font:inherit;outline:none}.toggle{display:inline-flex;align-items:center;justify-content:center;flex:none;width:var(--space-target-min);height:var(--space-target-min);padding:0;border:0;border-radius:var(--rounded-sm);background:transparent;color:var(--action-ink);cursor:pointer}.toggle[aria-pressed=true]{background:var(--action-soft)}.icon{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.primary{display:flex;align-items:center;justify-content:center;width:100%;min-height:var(--space-control-height);margin-top:var(--space-3);border:0;border-radius:var(--rounded-sm);background:var(--action);color:var(--on-action);font:inherit;font-weight:var(--type-body-strong-font-weight);cursor:pointer}.primary:hover{background:var(--action-hover)}.error{display:flex;align-items:flex-start;gap:var(--space-2);margin:var(--space-3) 0 0;padding:2px var(--space-1);border-radius:var(--rounded-xs);color:var(--danger-ink);font-size:var(--type-body-sm-font-size);line-height:var(--type-body-sm-line-height)}.error .icon{margin-top:1px}.help{margin:var(--space-3) 0 0;color:var(--ink-muted);font-size:var(--type-body-sm-font-size);line-height:var(--type-body-sm-line-height)}";

/// The script that toggles the password field.
Parameter SCRIPT = "(function () { var button = document.getElementById('ocu-toggle'); var input = document.getElementById('ocu-pass'); if (!button || !input) { return; } button.addEventListener('click', function () { var show = button.getAttribute('aria-pressed') !== 'true'; button.setAttribute('aria-pressed', show ? 'true' : 'false'); input.type = show ? 'text' : 'password'; }); }());";

ClassMethod Css() As %String
{
	Quit ..#CSS
}

ClassMethod Script() As %String
{
	Quit ..#SCRIPT
}

}
