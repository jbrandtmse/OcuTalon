/// The splash screen of the online demo (AD-13), which OcuTalon.Web.Public.Login hands the page to when the online-demo flag is
/// set. It is a Login subclass that renders its own page and reuses Login's policy, headers, entry point (Show), messages, images
/// and generators: Inheritance = right lets the parameters of OcuTalon.Web.Public.SplashAssets (its own stylesheet and script,
/// generated by web/scripts/tokens.mjs) win over Login's, so the hash generators and the policy pin the splash's two inline
/// blocks. UseSplash returns 0 here, so the hand-over does not loop. Like the local page it runs before sign-in with no roles
/// and keeps %CSP.Login's form contract: the action Error:FullURL, InsertHiddenFields right after the form tag, and the fields
/// IRISUsername, IRISPassword and IRISLogin. Its POST carries no field but IRISSessionToken and those three.
/// The state "addressLimit" (a sign-in that the per-address limit refused, Story 16.3) shows TOOMANY under the button, with a time
/// element whose datetime is the until time that Show was given and that the script fills in page time.
/// The state "busy" (the demo cannot take another session, Story 16.5) shows BUSY under the button, then the README link as the footer
/// writes it (ReadmeLink), and keeps the published values and marks nothing. OnPreHTTP decides it once, before the header is written: a
/// request with no state and no message (no wrong-credentials code, no no-role state) is shown in state busy while Status.Busy() is 1,
/// and every page in state busy, this one or the post-sign-in refusal's, carries the header Status.BUSYHEADER. Show and a direct render
/// call OnPreHTTP first. Without a valid connection cap Busy answers 0, so a local install never shows it.
/// Every other value comes from OcuTalon.Data.Public.Settings and is HTML-escaped where it is written. The page has one inline style,
/// one inline script, no style attribute, no external file and no font. Its own texts are parameters, each equal to a splash.*
/// catalog key except the interval words, which the UX does not quote alone; the labels and the error texts are Login's, equal to
/// signIn.* keys (AD-3). A non-ASCII character in them would be an HTML entity.
Class OcuTalon.Web.Public.Splash Extends (OcuTalon.Web.Public.Login, OcuTalon.Web.Public.SplashAssets) [ Inheritance = right ]
{

Parameter TITLE = "Try OcuTalon";

Parameter HEADING = "Try OcuTalon in two minutes";

Parameter SUBHEADING = "Break the feed, and approve the fix from your phone.";

Parameter DESCRIPTION = "OcuTalon is an assistant that lives inside InterSystems IRIS Interoperability. When a feed breaks, it reads the failed messages and the trace, names the cause in plain English, and proposes a fix that waits for your approval. For everything that arrives, an AI Hub agent makes one attention decision (ignore it, save it for your daily digest, tell you now, or act), and every decision, with its reasons and cost, is a production message you can open in Visual Trace. No API key needed.";

Parameter SIGNINHEADING = "Sign in to the demo";

Parameter SESSIONNOTE = "Your session is yours alone and lasts until the next reset. Signing in again from this browser picks it up.";

Parameter WARNING = "Other visitors can see messages in Visual Trace, so don't type personal information.";

Parameter SUBMIT = "Sign in and start";

Parameter COPYUSERNAME = "Copy user name";

Parameter COPYPASSWORD = "Copy password";

Parameter COPIED = "Copied";

Parameter COPYFAILED = "Couldn't copy. Select the text and copy it yourself.";

Parameter BEFOREHEADING = "Before you start";

/// The reset line: {interval} is written by the server, {time} and {countdown} by the page's script.
Parameter RESETLINE = "The demo resets every {interval}. Next reset: {time} ({countdown}).";

Parameter OWNLINE = "Your chat, phone, mailbox and orders are yours alone.";

Parameter TELEGRAMLINE = "Have Telegram? You can scan a QR code inside to get the notices on your own phone.";

Parameter LIMITLINE = "Each session can send {limit} messages an hour in the chat or Telegram.";

/// The address-limit error (EXPERIENCE: Too many sessions); {time} is written by the server as the page's time element and
/// filled by the script.
Parameter TOOMANY = "Too many new sessions from your network this hour. You can start another at {time}.";

/// The busy error (EXPERIENCE: Demo busy), equal to the catalog's banner.demoBusy; the README link follows it.
Parameter BUSY = "The demo is busy right now. Try again in a few minutes, or install it yourself.";

Parameter SHELLLINE = "OcuTalon can't run shell commands, and every action it takes is recorded in the IRIS audit log.";

/// The Visual Trace card's text: the part up to and including the first comma is the card's heading, the rest its paragraph.
Parameter VISUALTRACE = "Read-only Visual Trace account, for opening Visual Trace in the portal yourself (trace links on the page are already signed in). See each decision with its cost, and every step.";

Parameter COPYTRACEUSERNAME = "Copy Visual Trace user name";

Parameter COPYTRACEPASSWORD = "Copy Visual Trace password";

Parameter FOOTERNOTE = "OcuTalon is inspired by OpenClaw and is not affiliated with or endorsed by the OpenClaw Foundation.";

Parameter INSTALL = "Install it yourself (README)";

Parameter NEWTAB = "(opens in a new tab)";

/// The reset interval in hours, for one hour and for any other count.
Parameter INTERVALONE = "{n} hour";

Parameter INTERVALOTHER = "{n} hours";

Parameter README = "https://github.com/jbrandtmse/OcuTalon#readme";

/// Lucide copy, external-link and triangle-alert (ISC), drawn on a 24 grid; the triangle marks the warning notice.
Parameter ICONCOPY = "<rect width=""14"" height=""14"" x=""8"" y=""8"" rx=""2"" ry=""2""/><path d=""M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2""/>";

Parameter ICONEXTERNAL = "<path d=""M15 3h6v6""/><path d=""M10 14 21 3""/><path d=""M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6""/>";

Parameter ICONWARNING = "<path d=""m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3""/><path d=""M12 9v4""/><path d=""M12 17h.01""/>";

/// The splash does not hand the page on again.
ClassMethod UseSplash() As %Boolean
{
	Quit 0
}

/// Decides the busy state before the header is written: with no state and no message, and the demo busy, the state becomes "busy"
/// (OnLoginPage reads it). The state "busy" gets the marker header Status.BUSYHEADER, whichever way it came.
ClassMethod OnPreHTTP() As %Boolean [ ServerOnly = 1 ]
{
	Set ok = ##super()
	If ($Get(%OcuTalonState) = "") && (..Message("", $Get(%request.Data("Error:ErrorCode", 1)), 0) = "") && ##class(OcuTalon.Web.Public.Status).Busy() {
		Set %OcuTalonState = "busy"
	}
	If $Get(%OcuTalonState) = "busy" Do %response.SetHeader(##class(OcuTalon.Web.Public.Status).#BUSYHEADER, "1")
	Quit ok
}

/// Writes the page. A wrong password marks both fields, keeps the typed user name and leaves the password empty; the no-role
/// state marks nothing and keeps the published values. Each puts its message under the button and focuses it. With no message
/// nothing has the focus. The state "addressLimit" (a sign-in that the address limit refused) puts TOOMANY there, with {time} as
/// a time element whose datetime is the until time that Show was given (empty in the markup, filled by the script), keeps the
/// published values and marks nothing. A reset time or an interval that is not set leaves out the reset line, no allowance leaves out the
/// limit line, and no read-only user or password leaves out the Visual Trace card.
ClassMethod OnLoginPage() As %Status
{
	Set state = $Get(%OcuTalonState)
	Set until = $Get(%OcuTalonUntil)
	Kill %OcuTalonState, %OcuTalonUntil
	Set message = ..Message(state, $Get(%request.Data("Error:ErrorCode", 1)), 0)
	If state = "addressLimit" {
		Set message = $Replace(..#TOOMANY, "{time}", "<time class=""tnum"" id=""ocu-error-time"" datetime="""_$ZConvert(until, "O", "HTML")_"""></time>")
	}
	If state = "busy" Set message = ..#BUSY_" "_..ReadmeLink()
	Set marked = (message = ..#ERRORCREDENTIALS)
	Set base = %request.Application
	If $Extract(base, $Length(base)) '= "/" Set base = base_"/"
	Set base = $ZConvert(base, "O", "HTML")
	Set action = $ZConvert($Get(%request.Data("Error:FullURL", 1)), "O", "HTML")
	Set demoUser = ##class(OcuTalon.Data.Public.Settings).Get("demoUser")
	Set demoPassword = ##class(OcuTalon.Data.Public.Settings).Get("demoPassword")
	Set user = $Select(marked: $Get(%request.Data("IRISUsername", 1)), 1: demoUser)
	Set password = $Select(marked: "", 1: demoPassword)
	Set user = $ZConvert(user, "O", "HTML")
	Set password = $ZConvert(password, "O", "HTML")
	Set invalid = $Select(marked: " invalid", 1: "")
	Set described = $Select(marked: " aria-invalid=""true"" aria-describedby=""ocu-error""", 1: "")

	Write "<!DOCTYPE html>", !
	Write "<html lang=""en""><head><meta charset=""utf-8"">", !
	Write "<meta name=""viewport"" content=""width=device-width, initial-scale=1"">", !
	Write "<title>", ..#TITLE, "</title>", !
	Write "<link rel=""icon"" type=""image/png"" href=""", base, ..#FAVICON, """>", !
	Write "<style>", ..#CSS, "</style>", !
	Write "</head><body><div class=""splash""><main>", !
	Write "<picture><source media=""(prefers-color-scheme: dark)"" srcset=""", base, $Piece(..#LOGODARK, ",", 1), " 1x, ", base, $Piece(..#LOGODARK, ",", 2), " 2x"">"
	Write "<img class=""full-logo"" src=""", base, $Piece(..#LOGOLIGHT, ",", 1), """ srcset=""", base, $Piece(..#LOGOLIGHT, ",", 1), " 1x, ", base, $Piece(..#LOGOLIGHT, ",", 2), " 2x"" alt=""", ..#LOGOALT, """ width=""240"" height=""134""></picture>", !
	Write "<h1>", ..#HEADING, "</h1>", !
	Write "<p class=""subhead"">", ..#SUBHEADING, "</p>", !
	Write "<p class=""lead"">", ..#DESCRIPTION, "</p>", !
	Write "<div class=""splash-cards"">", !

	Write "<section class=""card"" aria-labelledby=""ocu-signin-h"" data-card><h2 class=""card-title"" id=""ocu-signin-h"">", ..#SIGNINHEADING, "</h2>", !
	Write "<form name=""Login"" method=""post"" action=""", action, """>", !
	Write ..InsertHiddenFields($ZConvert($Get(%request.Data("Error:URL", 1)), "O", "HTML")), !
	Write "<div class=""field"" data-row><label class=""field-label"" for=""ocu-user"">", ..#USERLABEL, "</label>"
	Write "<div class=""input", invalid, """><input id=""ocu-user"" type=""text"" name=""IRISUsername"" autocomplete=""off"" autocapitalize=""none"" spellcheck=""false"" value=""", user, """", described, ">"
	Write "<span class=""copied"" data-copied hidden>", ..#COPIED, "</span>", ..CopyButton("ocu-user", ..#COPYUSERNAME), "</div></div>", !
	Write "<div class=""field"" data-row><label class=""field-label"" for=""ocu-pass"">", ..#PASSWORDLABEL, "</label>"
	Write "<div class=""input", invalid, """><input id=""ocu-pass"" type=""text"" name=""IRISPassword"" autocomplete=""off"" autocapitalize=""none"" spellcheck=""false"" value=""", password, """", described, ">"
	Write "<span class=""copied"" data-copied hidden>", ..#COPIED, "</span>", ..CopyButton("ocu-pass", ..#COPYPASSWORD), "</div></div>", !
	Write ..Failure(), !
	Write "<p class=""hint"">", ..#SESSIONNOTE, "</p>", !
	Write "<div class=""notice"" id=""ocu-warning"">", ..Icon(..#ICONWARNING), "<p>", ..#WARNING, "</p></div>", !
	Write "<button class=""btn-primary"" type=""submit"" name=""IRISLogin"" value=""", ..#SUBMIT, """ aria-describedby=""ocu-warning"">", ..#SUBMIT, "</button>", !
	If message '= "" {
		Write "<p class=""field-error"" id=""ocu-error"" tabindex=""-1"" autofocus>", ..Icon(..#ICONALERT), "<span>", message, "</span></p>", !
	}
	Write "</form></section>", !

	Write "<section class=""card"" aria-labelledby=""ocu-before-h""><h2 class=""card-title"" id=""ocu-before-h"">", ..#BEFOREHEADING, "</h2>", !
	Write "<ul class=""facts"">", !
	Write ..ResetLine(), !
	Write "<li>", ..#OWNLINE, "</li>", !
	Write "<li>", ..#TELEGRAMLINE, "</li>", !
	Set limit = ##class(OcuTalon.Data.Public.Settings).Get("messageAllowance")
	If limit '= "" Write "<li>", $Replace(..#LIMITLINE, "{limit}", $ZConvert(limit, "O", "HTML")), "</li>", !
	Write "<li>", ..#SHELLLINE, "</li>", !
	Write "</ul></section>", !
	Write "</div>", !
	Write ..TraceCard(), !
	Write "</main>", !

	Write "<footer class=""splash-footer""><p>", ..#FOOTERNOTE, "</p>"
	Write ..ReadmeLink(), "</footer>", !
	Write "</div>", !
	Write "<div class=""sr-only"" id=""ocu-live"" role=""status"" aria-live=""polite"" aria-atomic=""true""></div>", !
	Write "<script>", ..#SCRIPT, "</script>", !
	Write "</body></html>", !
	Quit $SYSTEM.Status.OK()
}

/// The README link: the footer's, and the busy error's.
ClassMethod ReadmeLink() As %String [ Private ]
{
	Quit "<a class=""link"" href="""_..#README_""" target=""_blank"" rel=""noopener noreferrer"">"_..#INSTALL_"<span class=""sr-only""> "_..#NEWTAB_"</span>"_..Icon(..#ICONEXTERNAL)_"</a>"
}

/// The copy button of the element with the id source.
ClassMethod CopyButton(source As %String, name As %String) As %String [ Private ]
{
	Quit "<button class=""icon-btn"" type=""button"" data-copy="""_source_""" aria-label="""_name_""">"_..Icon(..#ICONCOPY)_"</button>"
}

/// The failure line of a card, hidden until a copy fails: the circle-alert icon and the text.
ClassMethod Failure() As %String [ Private ]
{
	Quit "<p class=""field-error"" data-failure hidden>"_..Icon(..#ICONALERT)_"<span>"_..#COPYFAILED_"</span></p>"
}

/// The reset line, or "" with no next reset or no interval. The server writes the interval, the next reset (datetime) and the
/// interval in seconds (data-step); the script fills in the time and the countdown and rolls forward by the step.
ClassMethod ResetLine() As %String [ Private ]
{
	Set next = ##class(OcuTalon.Data.Public.Settings).NextReset()
	Set interval = ##class(OcuTalon.Data.Public.Settings).Get("resetIntervalHours")
	If (next = "") || (interval = "") Quit ""
	Set count = +interval
	Set words = $Replace($Select(count = 1: ..#INTERVALONE, 1: ..#INTERVALOTHER), "{n}", $ZConvert(count, "O", "HTML"))
	Set line = $Replace(..#RESETLINE, "{interval}", words)
	Set before = $Piece(line, "{time}", 1)
	Set after = $Piece(line, "{time}", 2, *)
	Set between = $Piece(after, "{countdown}", 1)
	Set end = $Piece(after, "{countdown}", 2, *)
	Quit "<li>"_before_"<span class=""nowrap""><time class=""tnum"" id=""ocu-reset-time"" datetime="""_$ZConvert(next, "O", "HTML")_""" data-step="""_(interval * 3600 \ 1)_"""></time>"_between_"<span class=""tnum"" id=""ocu-countdown"" aria-hidden=""true""></span><span class=""sr-only"" id=""ocu-countdown-spoken""></span>"_end_"</span></li>"
}

/// The Visual Trace card, or "" when the read-only user or password is not set.
ClassMethod TraceCard() As %String [ Private ]
{
	Set user = ##class(OcuTalon.Data.Public.Settings).Get("readonlyUser")
	Set password = ##class(OcuTalon.Data.Public.Settings).Get("readonlyPassword")
	If (user = "") || (password = "") Quit ""
	Set text = ..#VISUALTRACE
	Set heading = $Piece(text, ",", 1)_","
	Set rest = $ZStrip($Piece(text, ",", 2, *), "<W")
	Set html = "<section class=""card vt-card"" aria-labelledby=""ocu-vt-h"" data-card>"
	Set html = html_"<div class=""vt-text""><h2 class=""card-title"" id=""ocu-vt-h"">"_heading_"</h2><p>"_rest_"</p></div>"
	Set html = html_"<div class=""vt-creds""><dl class=""creds"">"
	Set html = html_..TraceRow(..#USERLABEL, "ocu-vt-user", user, ..#COPYTRACEUSERNAME)
	Set html = html_..TraceRow(..#PASSWORDLABEL, "ocu-vt-pass", password, ..#COPYTRACEPASSWORD)
	Quit html_"</dl>"_..Failure()_"</div></section>"
}

/// One credential row of the Visual Trace card: the label, the value and its copy button.
ClassMethod TraceRow(label As %String, id As %String, value As %String, copyName As %String) As %String [ Private ]
{
	Quit "<div class=""cred"" data-row><dt>"_label_"</dt><dd><span id="""_id_""">"_$ZConvert(value, "O", "HTML")_"</span><span class=""copied"" data-copied hidden>"_..#COPIED_"</span>"_..CopyButton(id, copyName)_"</dd></div>"
}

}
