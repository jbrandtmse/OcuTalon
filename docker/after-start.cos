Set ok=1,done=0,img=$SYSTEM.Util.GetEnviron("OCUTALON_IMAGE_VERSION"),dev=($SYSTEM.Util.GetEnviron("OCUTALON_DEV")=1),pub=$SYSTEM.Util.GetEnviron("OCUTALON_PUBLIC_CLASSES"),ipmwant="0.10.10",ipmfile="/opt/ocutalon/ipm/zpm-0.10.10.xml",pkgdir="/opt/ocutalon/src",inst="",bad="",pubdir=""
If img="" { Set ok=0 Write !,"STEP version FAILED the image has no version" }
If ok { Try { Zn "OCUTALON" If ##class(%Dictionary.CompiledClass).%ExistsId("OcuTalon.Data.Public.Settings") { Set sc=##class(OcuTalon.Data.Public.Settings).ClearReady() If $SYSTEM.Status.IsError(sc) { Set ok=0 Write !,"STEP readiness FAILED ",$Translate($SYSTEM.Status.GetErrorText(sc),$Char(13,10),"  ") } Else { Write !,"STEP readiness cleared" } } Else { Write !,"STEP readiness nothing to clear" } Set done=done+1 } Catch e { Set ok=0 Write !,"STEP readiness FAILED ",$Translate(e.DisplayString(),$Char(13,10),"  ") } }
If ok { Try { Zn "%SYS" Set have="",m="" Try { Set m=##class(%IPM.Storage.Module).NameOpen("zpm") Set:$IsObject(m) have=m.VersionString } Catch e1 { } Set need=(have="") If 'need { Try { Set need=##class(%IPM.General.SemanticVersion).FromString(ipmwant).Follows(m.Version) } Catch e2 { Set need=1 } } If need { Set sc=$SYSTEM.OBJ.Load(ipmfile,"ck-d") If $SYSTEM.Status.IsError(sc) { Set ok=0 Write !,"STEP ipm FAILED ",$Translate($SYSTEM.Status.GetErrorText(sc),$Char(13,10),"  ") } Else { Write !,"STEP ipm installed ",ipmwant," (was ",$Select(have="":"none",1:have),")" } } Else { Write !,"STEP ipm present ",have } Set done=done+1 } Catch e { Set ok=0 Write !,"STEP ipm FAILED ",$Translate(e.DisplayString(),$Char(13,10),"  ") } }
If ok { Try { Zn "%SYS" Set sc=##class(Config.Databases).Get("OCUTALON_PUBLIC",.dp) Set pubdir=##class(%File).NormalizeDirectory($Get(dp("Directory"))) If '##class(Config.MapPackages).Exists("OCUTALON","%IPM") { Set sc=##class(%IPM.Main).Shell("enable -map -ns OCUTALON -q") If $SYSTEM.Status.IsError(sc) { Set ok=0 Write !,"STEP ipm-map FAILED ",$Translate($SYSTEM.Status.GetErrorText(sc),$Char(13,10),"  ") } Else { Write !,"STEP ipm-map mapped into OCUTALON" } } Else { Write !,"STEP ipm-map already mapped" } Set done=done+1 } Catch e { Set ok=0 Write !,"STEP ipm-map FAILED ",$Translate(e.DisplayString(),$Char(13,10),"  ") } }
If ok { Try { Zn "OCUTALON" Try { Set m=##class(%IPM.Storage.Module).NameOpen("ocutalon") Set:$IsObject(m) inst=m.VersionString } Catch e1 { } If inst="" { Write !,"STEP public-classes skipped (package not installed)" } Else { For i=1:1:$Length(pub,",") { Set c=$Piece(pub,",",i) Continue:c=""  Quit:bad'=""  Set cd=##class(%Dictionary.CompiledClass).%ExistsId(c) Set rd=##class(%File).NormalizeDirectory($Piece(##class(%SYS.Namespace).GetRoutineDest("OCUTALON",c_".1","INT"),"^",2)) Set:'cd bad=c_" is not compiled" Set:cd&&(rd'=pubdir) bad=c_" resolves to "_rd } Write !,"STEP public-classes ",$Select(bad="":"ok",1:bad) } Set done=done+1 } Catch e { Set ok=0 Write !,"STEP public-classes FAILED ",$Translate(e.DisplayString(),$Char(13,10),"  ") } }
Set why=$Select(inst="":"not installed",inst'=img:"version "_inst_" to "_img,dev:"dev",bad'="":"public classes",1:"")
If ok { Try { If why="" { Write !,"STEP package skipped ",inst } Else { Set sc=##class(%IPM.Main).Shell("load "_pkgdir) If $SYSTEM.Status.IsError(sc) { Set ok=0 Write !,"STEP package FAILED ",$Translate($SYSTEM.Status.GetErrorText(sc),$Char(13,10),"  ") } Else { Set inst="" Try { Set inst=##class(%IPM.Storage.Module).NameOpen("ocutalon").VersionString } Catch e1 { } If inst'=img { Set ok=0 Write !,"STEP package FAILED the installed version is '",inst,"', the image has ",img } Else { Write !,"STEP package loaded (",why,")" } } } Set done=done+1 } Catch e { Set ok=0 Write !,"STEP package FAILED ",$Translate(e.DisplayString(),$Char(13,10),"  ") } }
If ok { Try { Set sc=##class(OcuTalon.Install.Registry).Run("after-start") Set:$SYSTEM.Status.IsError(sc) ok=0 Set done=done+1 } Catch e { Set ok=0 Write !,"STEP registry FAILED ",$Translate(e.DisplayString(),$Char(13,10),"  ") } }
If ok,done'=6 { Set ok=0 Write !,"STEP script FAILED ",done," of 6 phases completed" }
Write !,"RESULT ",$Select(ok:"OK",1:"FAILED")," ",inst,!
Halt
