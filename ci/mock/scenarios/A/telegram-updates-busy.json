{
  "name": "telegram-updates-busy",
  "match": {
    "telegram": "getUpdates"
  },
  "replies": [
    {
      "status": 429,
      "body": {
        "ok": false,
        "error_code": 429,
        "description": "Too Many Requests: retry after 3",
        "parameters": { "retry_after": 3 }
      }
    }
  ]
}
